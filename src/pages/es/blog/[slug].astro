---
import ArticlePage from '../../../components/pages/Article.astro';
import { articleSlugs, getArticle } from '../../../lib/articles';

export async function getStaticPaths() {
	const slugs = await articleSlugs();
	return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const article = await getArticle('es', slug!);

if (!article) throw new Error(`unknown article: ${slug}`);
---

<ArticlePage lang="es" {article} />
