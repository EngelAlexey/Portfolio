---
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistLatinExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoLatinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import '../app.css';

import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import LangSwitch from '../components/LangSwitch.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { hasArticles } from '../lib/articles';
import { feedPath, path, t, type Lang, type RouteKey } from '../lib/i18n';
import { ANALYTICS, PERSON } from '../lib/site';

interface Props {
	lang: Lang;
	key: RouteKey | null;
	slug?: string;
	slugs?: Record<Lang, string>;
	title: string;
	description: string;
	image?: string | null;
	noindex?: boolean;
	analytics?: boolean;
	published?: string | null;
	updated?: string | null;
}

const {
	lang,
	key,
	slug,
	slugs,
	title,
	description,
	image = null,
	noindex = false,
	analytics = true,
	published = null,
	updated = null
} = Astro.props;

const face = (family: string, weight: string, url: string, range: string) => `
@font-face {
	font-family: '${family}';
	font-style: normal;
	font-display: swap;
	font-weight: ${weight};
	src: url(${url}) format('woff2-variations');
	unicode-range: ${range};
}`;

const LATIN =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
	'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

const fontFaces = [
	face('Geist Variable', '100 900', geistLatin, LATIN),
	face('Geist Variable', '100 900', geistLatinExt, LATIN_EXT),
	face('JetBrains Mono Variable', '100 800', monoLatin, LATIN),
	face('JetBrains Mono Variable', '100 800', monoLatinExt, LATIN_EXT)
].join('\n');

const gaId = import.meta.env.PROD && analytics ? ANALYTICS.ga4 : null;
const gtagInit = gaId
	? `window.dataLayer = window.dataLayer || [];
function gtag() {
	dataLayer.push(arguments);
}
gtag('js', new Date());
gtag('config', '${gaId}');`
	: '';

const notrackInit = `try {
	var notrack = new URLSearchParams(location.search).get('notrack');
	if (notrack === '1') localStorage.setItem('notrack', '1');
	if (notrack === '0') localStorage.removeItem('notrack');
	if (localStorage.getItem('notrack') === '1') {
		${gaId ? `window['ga-disable-${gaId}'] = true;` : ''}
		window.webAnalyticsBeforeSend = function () {
			return null;
		};
	}
} catch (e) {}`;

const strings = t(lang);
const current = key;

const showBlog = await hasArticles(lang);

const links = [
	{ key: 'home', href: path(lang, 'home'), label: strings.nav.home },
	{ key: 'projects', href: path(lang, 'projects'), label: strings.nav.projects },
	...(showBlog ? [{ key: 'blog', href: path(lang, 'blog'), label: strings.nav.blog }] : []),
	{ key: 'tools', href: path(lang, 'tools'), label: strings.nav.tools },
	{ key: 'about', href: path(lang, 'about'), label: strings.nav.about },
	{ key: 'contact', href: path(lang, 'contact'), label: strings.nav.contact }
] as { key: RouteKey; href: string; label: string }[];

const parentOf: Partial<Record<RouteKey, RouteKey>> = {
	project: 'projects',
	article: 'blog',
	scanner: 'tools',
	scannerAbout: 'tools',
	scannerReport: 'tools',
	schemaflow: 'tools'
};

const toolLinks = [
	{ key: 'scanner', href: path(lang, 'scanner'), label: strings.nav.scanner, icon: 'shield' },
	{ key: 'schemaflow', href: path(lang, 'schemaflow'), label: strings.nav.schemaflow, icon: 'diagram' }
] as const;

const toolSection: Partial<Record<RouteKey, RouteKey>> = { scanner: 'scanner', scannerAbout: 'scanner', scannerReport: 'scanner', schemaflow: 'schemaflow' };
const currentTool = current === null ? null : (toolSection[current] ?? null);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />
		<style is:inline set:html={fontFaces}></style>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/img/favicon-96.png" sizes="96x96" type="image/png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
		<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#17171c" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			try {
				var stored = localStorage.getItem('theme');
				if (stored === 'dark' || stored === 'light') {
					document.documentElement.dataset.theme = stored;
				}
			} catch (e) {}

			window.addEventListener('pagereveal', function (e) {
				if (e.viewTransition) document.documentElement.dataset.vt = '';
			});
		</script>
		<script is:inline set:html={notrackInit}></script>
		{gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
		{gaId && <script is:inline set:html={gtagInit}></script>}
		{
			showBlog && (
				<link
					rel="alternate"
					type="application/rss+xml"
					title={`${PERSON.name} | ${strings.blog.title}`}
					href={feedPath(lang)}
				/>
			)
		}
		<Seo {lang} {key} {slug} {slugs} {title} {description} {image} {noindex} {published} {updated} />
	</head>

	<body>
		{analytics && <Analytics />}
		{analytics && <SpeedInsights />}
		<script is:inline>
			(function () {
				var tags = ['vercel-analytics', 'vercel-speed-insights'];
				for (var i = 0; i < tags.length; i++) {
					var el = document.querySelector(tags[i]);
					if (!el) continue;
					var seen = el.getAttribute('data-pathname');
					if (seen) el.setAttribute('data-pathname', seen.replace(/\.html$/, ''));
				}
			})();
		</script>

		<a class="skip" href="#main">{strings.a11y.skipToContent}</a>

		<div class="shell">
			<header class="header">
				<a class="brand" href={path(lang, 'home')}>
					<span class="brand-name">Alex Herrera</span>
					<span class="brand-role">{strings.home.role}</span>
				</a>

				<div class="controls">
					<nav aria-label={strings.nav.menu}>
						<ul>
							{
								links.map((link) =>
									link.key === 'tools' ? (
										<li class="group" data-nav-group>
											<button
												type="button"
												class="group-toggle"
												aria-expanded="false"
												aria-controls="nav-tools"
												data-current={current === 'tools' || currentTool !== null ? '' : undefined}
												data-nav-toggle
											>
												{link.label}
												<svg class="chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
													<path d="m6 9 6 6 6-6" />
												</svg>
											</button>
											<ul class="sub" id="nav-tools">
												{toolLinks.map((tool) => (
													<li>
														<a href={tool.href} aria-current={currentTool === tool.key ? 'page' : undefined}>
															<span class="sub-icon" aria-hidden="true">
																{tool.icon === 'shield' ? (
																	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
																		<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z" />
																		<path d="m9 12 2 2 4-4" />
																	</svg>
																) : (
																	<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
																		<rect x="3" y="3" width="7" height="7" rx="1.5" />
																		<rect x="14" y="14" width="7" height="7" rx="1.5" />
																		<path d="M10 6.5h3.5a2 2 0 0 1 2 2V14" />
																	</svg>
																)}
															</span>
															<span class="sub-text">
																<span class="sub-name">{tool.label}</span>
																<span class="sub-body">{strings.tools.items[tool.key].body}</span>
															</span>
														</a>
													</li>
												))}
												<li class="sub-all">
													<a href={link.href} aria-current={current === 'tools' ? 'page' : undefined}>
														{strings.tools.title}
														<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<path d="M5 12h14M13 6l6 6-6 6" />
														</svg>
													</a>
												</li>
											</ul>
										</li>
									) : (
										<li>
											<a
												href={link.href}
												aria-current={
													current === link.key ||
													(current !== null && parentOf[current] === link.key)
														? 'page'
														: undefined
												}
											>
												{link.label}
											</a>
										</li>
									)
								)
							}
						</ul>
					</nav>

					<div class="tools">
						<LangSwitch {lang} routeKey={key ?? 'home'} {slug} {slugs} />
						<ThemeToggle {lang} />
					</div>
				</div>
			</header>

			<main id="main" aria-label={strings.a11y.mainLandmark}>
				<slot />
			</main>

			<footer class="footer">
				<p>© {new Date().getFullYear()} {PERSON.name}</p>
				<p class="built">{strings.footer.builtWith}</p>
			</footer>
		</div>

		<script is:inline>
			(() => {
				const group = document.querySelector('[data-nav-group]');
				const toggle = group && group.querySelector('[data-nav-toggle]');
				if (!group || !toggle) return;

				/** @param {boolean} open */
				const setOpen = (open) => {
					toggle.setAttribute('aria-expanded', String(open));
					if (open) group.setAttribute('data-open', '');
					else group.removeAttribute('data-open');
				};

				toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
				document.addEventListener('click', (e) => {
					if (e.target instanceof Node && !group.contains(e.target)) setOpen(false);
				});
				group.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
						setOpen(false);
						toggle.focus();
					}
				});
				group.addEventListener('focusout', (e) => {
					if (!(e.relatedTarget instanceof Node) || !group.contains(e.relatedTarget)) setOpen(false);
				});
			})();
		</script>

		<script is:inline>
			(() => {
				const root = document.documentElement;

				/** @param {EventTarget | null} node */
				const areaOf = (node) => {
					if (!(node instanceof Element)) return null;
					const source = node.closest('[data-area-source]');
					return source instanceof HTMLElement ? (source.dataset.area ?? null) : null;
				};

				/** @param {string | null} area */
				const set = (area) => {
					if (area) root.dataset.areaFocus = area;
					else delete root.dataset.areaFocus;
				};

				document.addEventListener('pointerover', (e) => {
					if (e.pointerType === 'mouse') set(areaOf(e.target));
				});
				document.addEventListener('pointerdown', (e) => {
					if (e.pointerType !== 'mouse') set(null);
				});
				root.addEventListener('pointerleave', () => set(null));
				document.addEventListener('focusin', (e) => {
					const el = e.target;
					set(el instanceof Element && el.matches(':focus-visible') ? areaOf(el) : null);
				});
				document.addEventListener('focusout', () => set(null));
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') set(null);
				});
			})();
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 0.5rem;
		top: -3rem;
		z-index: 50;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius-sm);
		background: var(--ink);
		color: var(--ink-inverted);
		font-size: 0.875rem;
		text-decoration: none;
		transition: top 120ms ease;
	}

	.skip:focus {
		top: 0.5rem;
	}

	.shell {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding: 0.85rem clamp(1rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line);
		background: color-mix(in oklab, var(--paper) 88%, transparent);
		backdrop-filter: blur(10px);
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		line-height: 1.2;
	}

	.brand-name {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.brand-role {
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	nav ul {
		display: flex;
		align-items: center;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		font-size: 0.9375rem;
		color: var(--ink-muted);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 1.5px solid transparent;
		transition: color 120ms ease;
	}

	nav a:hover {
		color: var(--ink);
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	.group {
		position: relative;
	}

	.group-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.25rem 0;
		border: 0;
		border-bottom: 1.5px solid transparent;
		background: none;
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.9375rem;
		cursor: pointer;
		transition: color 120ms ease;
	}

	.group-toggle:hover,
	.group[data-open] .group-toggle {
		color: var(--ink);
	}

	.group-toggle[data-current] {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	.group-toggle:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.chevron {
		transition: transform 150ms ease;
	}

	.group[data-open] .chevron {
		transform: rotate(180deg);
	}

	nav .sub {
		position: absolute;
		top: calc(100% + 0.6rem);
		left: -0.75rem;
		z-index: 30;
		display: none;
		flex-direction: column;
		align-items: stretch;
		gap: 0.15rem;
		width: 20rem;
		padding: 0.4rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--shadow-card), 0 12px 32px oklch(18% 0.008 260 / 0.08);
	}

	.group[data-open] .sub {
		display: flex;
	}

	@media (hover: hover) {
		.group:hover .sub {
			display: flex;
		}

		.group::after {
			content: '';
			position: absolute;
			inset: 100% -0.75rem auto;
			height: 0.75rem;
		}
	}

	nav .sub a {
		display: flex;
		align-items: flex-start;
		gap: 0.7rem;
		padding: 0.6rem 0.65rem;
		border: 0;
		border-radius: var(--radius-sm);
		color: var(--ink);
		transition: background 120ms ease;
	}

	nav .sub a:hover,
	nav .sub a:focus-visible {
		background: var(--paper-sunken);
	}

	nav .sub a[aria-current='page'] {
		background: var(--paper-sunken);
	}

	.sub-icon {
		display: inline-flex;
		flex: none;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--paper);
		color: var(--ink-muted);
	}

	nav .sub a[aria-current='page'] .sub-icon {
		border-color: var(--line-strong);
		color: var(--ink);
	}

	.sub-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.sub-name {
		font-size: 0.875rem;
		font-weight: 600;
	}

	.sub-body {
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	nav .sub-all {
		margin-top: 0.2rem;
		padding-top: 0.2rem;
		border-top: 1px solid var(--line);
	}

	nav .sub-all a {
		align-items: center;
		justify-content: space-between;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}

	nav .sub-all a:hover {
		color: var(--ink);
	}

	.tools {
		display: flex;
		gap: 0.5rem;
	}

	main {
		flex: 1;
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		padding: 2rem clamp(1rem, 4vw, 2.5rem);
		border-top: 1px solid var(--line);
		color: var(--ink-faint);
		font-size: 0.8125rem;
	}

	.footer p {
		margin: 0;
	}

	@media (max-width: 46rem) {
		.header {
			gap: 0.6rem;
		}

		.controls {
			width: 100%;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.5rem 0.75rem;
		}

		nav {
			flex: 1 1 auto;
			min-width: 0;
		}

		nav ul {
			flex-wrap: wrap;
			gap: 0.35rem 0.75rem;
		}

		nav a,
		.group-toggle {
			font-size: 0.8125rem;
		}

		.group {
			position: static;
		}

		nav .sub {
			left: 1rem;
			right: 1rem;
			top: auto;
			width: auto;
			margin-top: 0.5rem;
		}

		.tools {
			flex: none;
		}

		.built {
			flex-basis: 100%;
		}
	}
</style>
