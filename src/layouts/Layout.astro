---
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistLatinExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import monoLatinExt from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-ext-wght-normal.woff2?url';
import '../app.css';

import Analytics from '@vercel/analytics/astro';
import LangSwitch from '../components/LangSwitch.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { path, t, type Lang, type RouteKey } from '../lib/i18n';
import { ANALYTICS, PERSON } from '../lib/site';

interface Props {
	lang: Lang;
	key: RouteKey | null;
	slug?: string;
	title: string;
	description: string;
	image?: string | null;
	noindex?: boolean;
}

const {
	lang,
	key,
	slug,
	title,
	description,
	image = null,
	noindex = false
} = Astro.props;

const face = (family: string, weight: string, url: string, range: string) => `
@font-face {
	font-family: '${family}';
	font-style: normal;
	font-display: swap;
	font-weight: ${weight};
	src: url(${url}) format('woff2-variations');
	unicode-range: ${range};
}`;

const LATIN =
	'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT =
	'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';

const fontFaces = [
	face('Geist Variable', '100 900', geistLatin, LATIN),
	face('Geist Variable', '100 900', geistLatinExt, LATIN_EXT),
	face('JetBrains Mono Variable', '100 800', monoLatin, LATIN),
	face('JetBrains Mono Variable', '100 800', monoLatinExt, LATIN_EXT)
].join('\n');

// Solo en compilaciones: astro dev no manda sesiones de desarrollo a GA4.
const gaId = import.meta.env.PROD ? ANALYTICS.ga4 : null;
const gtagInit = gaId
	? `window.dataLayer = window.dataLayer || [];
function gtag() {
	dataLayer.push(arguments);
}
gtag('js', new Date());
gtag('config', '${gaId}');`
	: '';

const strings = t(lang);
const current = key;

const links = [
	{ key: 'home', href: path(lang, 'home'), label: strings.nav.home },
	{ key: 'projects', href: path(lang, 'projects'), label: strings.nav.projects },
	{ key: 'about', href: path(lang, 'about'), label: strings.nav.about },
	{ key: 'contact', href: path(lang, 'contact'), label: strings.nav.contact }
] as const;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={monoLatin} crossorigin />
		<style is:inline set:html={fontFaces}></style>
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/img/favicon-96.png" sizes="96x96" type="image/png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
		<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#17171c" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			try {
				var stored = localStorage.getItem('theme');
				if (stored === 'dark' || stored === 'light') {
					document.documentElement.dataset.theme = stored;
				}
			} catch (e) {
				// Blocked storage: fall back to prefers-color-scheme.
			}

			window.addEventListener('pagereveal', function (e) {
				// Arrived through a view transition: skip the entrance animations.
				if (e.viewTransition) document.documentElement.dataset.vt = '';
			});
		</script>
		{gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
		{gaId && <script is:inline set:html={gtagInit}></script>}
		<Seo {lang} {key} {slug} {title} {description} {image} {noindex} />
	</head>

	<body>
		<Analytics />
		<script is:inline>
			// build.format is 'file', so the component stamps data-pathname="/es.html",
			// and both the reported path and the route derived from it would name a URL
			// the site never serves. This runs while parsing, after the element exists
			// and before the deferred module upgrades it.
			(function () {
				var el = document.querySelector('vercel-analytics');
				if (!el) return;
				var seen = el.getAttribute('data-pathname');
				if (seen) el.setAttribute('data-pathname', seen.replace(/\.html$/, ''));
			})();
		</script>

		<a class="skip" href="#main">{strings.a11y.skipToContent}</a>

		<div class="shell">
			<header class="header">
				<a class="brand" href={path(lang, 'home')}>
					<span class="brand-name">Alex Herrera</span>
					<span class="brand-role">{strings.home.role}</span>
				</a>

				<div class="controls">
					<nav aria-label={strings.nav.menu}>
						<ul>
							{
								links.map((link) => (
									<li>
										<a
											href={link.href}
											aria-current={
												current === link.key ||
												(link.key === 'projects' && current === 'project')
													? 'page'
													: undefined
											}
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>

					<div class="tools">
						<LangSwitch {lang} routeKey={key ?? 'home'} {slug} />
						<ThemeToggle {lang} />
					</div>
				</div>
			</header>

			<main id="main" aria-label={strings.a11y.mainLandmark}>
				<slot />
			</main>

			<footer class="footer">
				<p>© {new Date().getFullYear()} {PERSON.name}</p>
				<p class="built">{strings.footer.builtWith}</p>
			</footer>
		</div>

		<script is:inline>
			(() => {
				const root = document.documentElement;

				/** @param {EventTarget | null} node */
				const areaOf = (node) => {
					if (!(node instanceof Element)) return null;
					const source = node.closest('[data-area-source]');
					return source instanceof HTMLElement ? (source.dataset.area ?? null) : null;
				};

				/** @param {string | null} area */
				const set = (area) => {
					if (area) root.dataset.areaFocus = area;
					else delete root.dataset.areaFocus;
				};

				document.addEventListener('pointerover', (e) => {
					if (e.pointerType === 'mouse') set(areaOf(e.target));
				});
				document.addEventListener('pointerdown', (e) => {
					if (e.pointerType !== 'mouse') set(null);
				});
				root.addEventListener('pointerleave', () => set(null));
				document.addEventListener('focusin', (e) => {
					const el = e.target;
					set(el instanceof Element && el.matches(':focus-visible') ? areaOf(el) : null);
				});
				document.addEventListener('focusout', () => set(null));
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') set(null);
				});
			})();
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 0.5rem;
		top: -3rem;
		z-index: 50;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius-sm);
		background: var(--ink);
		color: var(--ink-inverted);
		font-size: 0.875rem;
		text-decoration: none;
		transition: top 120ms ease;
	}

	.skip:focus {
		top: 0.5rem;
	}

	.shell {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding: 0.85rem clamp(1rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line);
		background: color-mix(in oklab, var(--paper) 88%, transparent);
		backdrop-filter: blur(10px);
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		line-height: 1.2;
	}

	.brand-name {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.brand-role {
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	nav ul {
		display: flex;
		align-items: center;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		font-size: 0.9375rem;
		color: var(--ink-muted);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 1.5px solid transparent;
		transition: color 120ms ease;
	}

	nav a:hover {
		color: var(--ink);
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	.tools {
		display: flex;
		gap: 0.5rem;
	}

	main {
		flex: 1;
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		padding: 2rem clamp(1rem, 4vw, 2.5rem);
		border-top: 1px solid var(--line);
		color: var(--ink-faint);
		font-size: 0.8125rem;
	}

	.footer p {
		margin: 0;
	}

	@media (max-width: 46rem) {
		.header {
			gap: 0.6rem;
		}

		.controls {
			width: 100%;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.5rem 0.75rem;
		}

		nav {
			flex: 1 1 auto;
			min-width: 0;
		}

		nav ul {
			flex-wrap: wrap;
			gap: 0.35rem 0.75rem;
		}

		nav a {
			font-size: 0.8125rem;
		}

		.tools {
			flex: none;
		}

		.built {
			flex-basis: 100%;
		}
	}
</style>
