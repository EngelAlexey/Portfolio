---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../app.css';

import Analytics from '@vercel/analytics/astro';
import LangSwitch from '../components/LangSwitch.astro';
import Seo from '../components/Seo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { path, t, type Lang, type RouteKey } from '../lib/i18n';
import { PERSON } from '../lib/site';

interface Props {
	lang: Lang;
	key: RouteKey | null;
	slug?: string;
	title: string;
	description: string;
	image?: string | null;
	person?: boolean;
	noindex?: boolean;
}

const {
	lang,
	key,
	slug,
	title,
	description,
	image = null,
	person = false,
	noindex = false
} = Astro.props;

const strings = t(lang);
const current = key;

const links = [
	{ key: 'home', href: path(lang, 'home'), label: strings.nav.home },
	{ key: 'projects', href: path(lang, 'projects'), label: strings.nav.projects },
	{ key: 'about', href: path(lang, 'about'), label: strings.nav.about },
	{ key: 'contact', href: path(lang, 'contact'), label: strings.nav.contact }
] as const;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
		<meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#17171c" media="(prefers-color-scheme: dark)" />
		<script is:inline>
			try {
				var stored = localStorage.getItem('theme');
				if (stored === 'dark' || stored === 'light') {
					document.documentElement.dataset.theme = stored;
				}
			} catch (e) {
				// Blocked storage: fall back to prefers-color-scheme.
			}
		</script>
		<Seo lang={lang} key={key ?? 'home'} {slug} {title} {description} {image} {person} {noindex} />
		<Analytics />
	</head>

	<body>
		<a class="skip" href="#main">{strings.a11y.skipToContent}</a>

		<div class="shell">
			<header class="header">
				<a class="brand" href={path(lang, 'home')}>
					<span class="brand-name">Alex Herrera</span>
					<span class="brand-role">{strings.home.role}</span>
				</a>

				<div class="controls">
					<nav aria-label={strings.nav.menu}>
						<ul>
							{
								links.map((link) => (
									<li>
										<a
											href={link.href}
											aria-current={
												current === link.key ||
												(link.key === 'projects' && current === 'project')
													? 'page'
													: undefined
											}
										>
											{link.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>

					<div class="tools">
						<LangSwitch {lang} routeKey={key ?? 'home'} {slug} />
						<ThemeToggle {lang} />
					</div>
				</div>
			</header>

			<main id="main" aria-label={strings.a11y.mainLandmark}>
				<slot />
			</main>

			<footer class="footer">
				<p>© {new Date().getFullYear()} {PERSON.name}</p>
				<p class="built">{strings.footer.builtWith}</p>
			</footer>
		</div>

		<script is:inline>
			(() => {
				const root = document.documentElement;

				/** @param {EventTarget | null} node */
				const areaOf = (node) => {
					if (!(node instanceof Element)) return null;
					const source = node.closest('[data-area-source]');
					return source instanceof HTMLElement ? (source.dataset.area ?? null) : null;
				};

				/** @param {string | null} area */
				const set = (area) => {
					if (area) root.dataset.areaFocus = area;
					else delete root.dataset.areaFocus;
				};

				document.addEventListener('pointerover', (e) => {
					if (e.pointerType === 'mouse') set(areaOf(e.target));
				});
				document.addEventListener('pointerdown', (e) => {
					if (e.pointerType !== 'mouse') set(null);
				});
				root.addEventListener('pointerleave', () => set(null));
				document.addEventListener('focusin', (e) => {
					const el = e.target;
					set(el instanceof Element && el.matches(':focus-visible') ? areaOf(el) : null);
				});
				document.addEventListener('focusout', () => set(null));
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') set(null);
				});
			})();
		</script>
	</body>
</html>

<style>
	.skip {
		position: absolute;
		left: 0.5rem;
		top: -3rem;
		z-index: 50;
		padding: 0.5rem 0.9rem;
		border-radius: var(--radius-sm);
		background: var(--ink);
		color: var(--ink-inverted);
		font-size: 0.875rem;
		text-decoration: none;
		transition: top 120ms ease;
	}

	.skip:focus {
		top: 0.5rem;
	}

	.shell {
		display: flex;
		flex-direction: column;
		min-height: 100dvh;
	}

	.header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding: 0.85rem clamp(1rem, 4vw, 2.5rem);
		border-bottom: 1px solid var(--line);
		background: color-mix(in oklab, var(--paper) 88%, transparent);
		backdrop-filter: blur(10px);
	}

	.brand {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		line-height: 1.2;
	}

	.brand-name {
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.brand-role {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--ink-faint);
		letter-spacing: 0.02em;
	}

	.controls {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	nav ul {
		display: flex;
		align-items: center;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	nav a {
		font-size: 0.9375rem;
		color: var(--ink-muted);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 1.5px solid transparent;
		transition: color 120ms ease;
	}

	nav a:hover {
		color: var(--ink);
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	.tools {
		display: flex;
		gap: 0.5rem;
	}

	main {
		flex: 1;
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		padding: 2rem clamp(1rem, 4vw, 2.5rem);
		border-top: 1px solid var(--line);
		color: var(--ink-faint);
		font-size: 0.8125rem;
	}

	.footer p {
		margin: 0;
	}

	@media (max-width: 46rem) {
		.header {
			gap: 0.6rem;
		}

		.controls {
			width: 100%;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.5rem 0.75rem;
		}

		nav {
			flex: 1 1 auto;
			min-width: 0;
		}

		nav ul {
			flex-wrap: wrap;
			gap: 0.35rem 0.75rem;
		}

		nav a {
			font-size: 0.8125rem;
		}

		.tools {
			flex: none;
		}

		.built {
			flex-basis: 100%;
		}
	}
</style>
