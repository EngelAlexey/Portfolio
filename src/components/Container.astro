---
interface Props {
	size?: 'wide' | 'text';
	as?: 'section' | 'div' | 'article' | 'header';
	class?: string;
}

const { size = 'wide', as = 'section', class: className } = Astro.props;
const Tag = as;
---

<Tag class:list={['container', size, className]}>
	<slot />
</Tag>

<style>
	.container {
		width: 100%;
		margin-inline: auto;
		padding-inline: clamp(1rem, 4vw, 2.5rem);
	}

	.wide {
		max-width: 74rem;
	}

	.text {
		max-width: 48rem;
	}
</style>
