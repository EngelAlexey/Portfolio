---
import OrgMark from './OrgMark.astro';
import ProjectCard from './ProjectCard.astro';
import { postAt, WORDMARKS } from '../lib/about';
import type { OrgGroup } from '../lib/content';
import { formatPeriod } from '../lib/format';
import { t, type Lang } from '../lib/i18n';

interface Props {
	groups: OrgGroup[];
	lang: Lang;
}

const { groups, lang } = Astro.props;
const strings = t(lang);

const post = (group: OrgGroup) => postAt(group.key, lang);
const wordmarked = (group: OrgGroup) => WORDMARKS.has(post(group)?.mark ?? '');

const years = (period: OrgGroup['period']) =>
	formatPeriod(period, strings.project.present, 'year');
---

<div class="timeline" data-timeline>
	<div class="rail" aria-hidden="true"><span class="fill" data-fill></span></div>

	<ol class="groups">
		{
			groups.map((group) => (
				<li class="group" data-org-group>
					<span class="node" aria-hidden="true" />

					<div class="head">
						{post(group)?.mark && (
							<span class="logo">
								<OrgMark org={post(group)!.mark!} width={112} />
							</span>
						)}

						<h2 class:list={{ 'sr-only': wordmarked(group) }}>
							{group.name ?? strings.projects.independent}
						</h2>

						{post(group) && <p class="post">{post(group)!.title}</p>}

						<p class="meta">
							{group.qualifier && <span class="qualifier">{group.qualifier}</span>}
							<span class="mono years">{years(group.period)}</span>
						</p>
					</div>

					<ul class="cards" data-project-list>
						{group.projects.map((project) => (
							<li data-areas={project.meta.areas.join(' ')}>
								<ProjectCard {project} {lang} omitOrg />
							</li>
						))}
					</ul>
				</li>
			))
		}
	</ol>
</div>

<style>
	.timeline {
		position: relative;
		padding-left: 2.25rem;
	}

	.rail {
		position: absolute;
		top: 0.84375rem;
		bottom: 0.84375rem;
		left: 0.3125rem;
		width: 1px;
		background: var(--line-strong);
	}

	.fill {
		display: block;
		width: 100%;
		height: 100%;
		background: var(--ink);
	}

	.groups {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.group {
		position: relative;
		padding-bottom: clamp(2.5rem, 6vw, 4rem);
	}

	.group:last-child {
		padding-bottom: 0;
	}

	.node {
		position: absolute;
		top: 0.5rem;
		left: -2.25rem;
		width: 0.6875rem;
		height: 0.6875rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: var(--paper);
		transition:
			background-color 260ms ease,
			border-color 260ms ease;
	}

	.group[data-reached] .node {
		background: var(--ink);
		border-color: var(--ink);
	}

	.logo {
		display: block;
		margin-bottom: 0.75rem;
		color: var(--ink-muted);
	}

	.head h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.post {
		margin: 0.2rem 0 0;
		font-size: 0.875rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.15rem 0.6rem;
		margin: 0.3rem 0 0;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}

	.years {
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
	}

	@media (min-width: 62rem) {
		.group {
			display: grid;
			grid-template-columns: 13rem minmax(0, 1fr);
			gap: 0 2.5rem;
			align-items: start;
		}

		.head {
			position: sticky;
			top: 5.25rem;
		}

		.cards {
			margin-top: 0;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 46rem) and (max-width: 61.99rem) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.node {
			transition: none;
		}
	}
</style>

<script>
	const timeline = document.querySelector<HTMLElement>('[data-timeline]');
	const rail = timeline?.querySelector<HTMLElement>('.rail');
	const fill = timeline?.querySelector<HTMLElement>('[data-fill]');

	if (timeline && rail && fill) {
		const groups = [...timeline.querySelectorAll<HTMLElement>('[data-org-group]')];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		if (reduced) {
			for (const group of groups) group.setAttribute('data-reached', '');
			fill.style.height = '100%';
		} else {
			let queued = false;

			const draw = () => {
				queued = false;

				const visible = groups.filter((group) => !group.hidden);
				const first = visible[0]?.querySelector<HTMLElement>('.node');
				const last = visible[visible.length - 1]?.querySelector<HTMLElement>('.node');
				if (first && last) {
					const from = first.getBoundingClientRect();
					const to = last.getBoundingClientRect();
					rail.style.height = `${Math.max(0, to.top - from.top)}px`;
					rail.style.bottom = 'auto';
				}

				const box = rail.getBoundingClientRect();

				const ended =
					innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
				const mark = ended ? Infinity : innerHeight * 0.55;

				fill.style.height = `${Math.min(Math.max(mark - box.top, 0), box.height)}px`;

				for (const group of groups) {
					if (group.hidden) continue;
					const node = group.querySelector<HTMLElement>('.node');
					if (!node) continue;
					const at = node.getBoundingClientRect().top + node.offsetHeight / 2;
					group.toggleAttribute('data-reached', at <= mark);
				}
			};

			const schedule = () => {
				if (queued) return;
				queued = true;
				requestAnimationFrame(draw);
			};

			addEventListener('scroll', schedule, { passive: true });
			addEventListener('resize', schedule, { passive: true });
			document.addEventListener('projects:filtered', schedule);
			draw();
		}
	}
</script>
