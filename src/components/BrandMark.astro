---
import type { Tool } from '../lib/brands';

interface Props {
	tool: Tool;
	size?: number;
}

const { tool, size = 22 } = Astro.props;
---

{
	tool.d ? (
		<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
			<path fill="currentColor" d={tool.d} />
		</svg>
	) : (
		<span class="monogram" style={`--size: ${size}px`} aria-hidden="true">
			{tool.monogram}
		</span>
	)
}

<style>
	svg {
		display: block;
	}

	.monogram {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		min-width: var(--size);
		height: var(--size);
		padding-inline: calc(var(--size) * 0.14);
		border: 1px solid currentColor;
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: calc(var(--size) * 0.42);
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}
</style>
