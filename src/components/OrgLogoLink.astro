---
import type { OrgMark as Mark } from '../lib/about';
import { markHref } from '../lib/org';
import OrgMark from './OrgMark.astro';

interface Props {
	org: Mark;
	width?: number;
}

const { org, width } = Astro.props;
const href = markHref(org);
---

{
	href ? (
		<a class="logolink" {href} rel="noreferrer" target="_blank" aria-hidden="true" tabindex="-1">
			<OrgMark {org} {...(width === undefined ? {} : { width })} />
		</a>
	) : (
		<OrgMark {org} {...(width === undefined ? {} : { width })} />
	)
}

<style>
	.logolink {
		display: inline-flex;
		color: inherit;
		text-decoration: none;
		border-radius: var(--radius);
		transition: opacity 0.15s ease;
	}

	.logolink:hover {
		opacity: 0.65;
	}
</style>
