---
interface Props {
	lang: 'es' | 'en';
}

const { lang } = Astro.props;

type Caso = {
	id: string;
	nombre: string;
	mirar: string;
	valores: Record<string, string>;
};

const T = {
	es: {
		titulo: 'Simulador de CORS',
		intro:
			'Su frontend está en http://localhost:5173 y su API en http://localhost:3000. La API devuelve el perfil o guarda un pedido solo si recibe la cookie de sesión.',
		casosTitulo: 'Elija un caso',
		propio: 'Combinación propia: cambie las opciones y mire el resultado.',
		opcionesTitulo: 'Opciones',
		campos: {
			pagina: 'Desde qué web se hace la petición',
			peticion: 'Qué pide la página',
			credenciales: '¿Envía la cookie de sesión?',
			modo: 'Modo de fetch',
			config: 'Cómo responde el servidor',
			cookie: 'Atributo SameSite de la cookie'
