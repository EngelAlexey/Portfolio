				valores: { pagina: 'http://localhost:5173', peticion: 'post-json', credenciales: 'same-origin', modo: 'cors', config: 'sin', cookie: 'none' }
			},
			{
				id: 'correcta',
				nombre: 'La configuración correcta',
				mirar: 'El servidor solo permite su frontend y acepta cookies. La petición previa pasa y la página lee la respuesta.',
				valores: { pagina: 'http://localhost:5173', peticion: 'post-json', credenciales: 'include', modo: 'cors', config: 'lista-cred', cookie: 'none' }
			},
			{
				id: 'robo',
				nombre: 'Otra web lee sus datos',
				mirar: 'El servidor devuelve cualquier Origin con cookies. Una web ajena lee el perfil del usuario con su sesión.',
				valores: { pagina: 'http://127.0.0.1:8080', peticion: 'get', credenciales: 'include', modo: 'cors', config: 'reflejo', cookie: 'none' }
			},
			{
				id: 'lax',
				nombre: 'SameSite=Lax lo frena',
				mirar: 'El mismo servidor inseguro, pero la cookie es SameSite=Lax. Desde otro sitio la cookie no se envía y la API responde 401.',
				valores: { pagina: 'http://127.0.0.1:8080', peticion: 'get', credenciales: 'include', modo: 'cors', config: 'reflejo', cookie: 'lax' }
			},
			{
				id: 'csrf',
				nombre: 'CORS no frena CSRF',
				mirar: 'El servidor está bien configurado y la otra web no puede leer la respuesta. Aun así, el pedido se guarda con la sesión del usuario.',
				valores: { pagina: 'http://localhost:8080', peticion: 'post-texto', credenciales: 'include', modo: 'cors', config: 'lista-cred', cookie: 'none' }
			}
		] as Caso[]
	},
	en: {
		titulo: 'CORS simulator',
		intro:
			'Your frontend is at http://localhost:5173 and your API at http://localhost:3000. The API returns the profile or saves an order only if it receives the session cookie.',
		casosTitulo: 'Pick a case',
		propio: 'Your own combination: change the options and look at the result.',
		opcionesTitulo: 'Options',
		campos: {
			pagina: 'Which site makes the request',
			peticion: 'What the page asks for',
			credenciales: 'Does it send the session cookie?',
			modo: 'fetch mode',
			config: 'How the server answers',
			cookie: 'Cookie SameSite attribute'
		},
		opciones: {
			pagina: {
				'http://localhost:5173': 'Your frontend (http://localhost:5173)',
				'http://localhost:8080': 'Another page on the same site (http://localhost:8080)',
				'http://127.0.0.1:8080': 'A page on another site (http://127.0.0.1:8080)'
			},
			peticion: {
				get: 'Read the profile (GET)',
				'post-texto': 'Create an order with text (POST)',
				'post-json': 'Create an order with JSON (POST)',
				'put-json': 'Change an order with JSON (PUT)',
				'get-auth': 'Read the profile with a token (GET + Authorization)'
			},
			credenciales: {
				'same-origin': 'No (fetch default)',
				include: "Yes: credentials: 'include'"
			},
			modo: { cors: 'Normal', 'no-cors': "mode: 'no-cors'" },
			config: {
				sin: 'No CORS headers',
				lista: 'Only allows your frontend (section 4)',
				'lista-cred': 'Only allows your frontend, with cookies (section 6)',
				comodin: 'Allows any site: *',
				reflejo: 'Returns the Origin it receives, with cookies',
				doble: 'Sends the header twice'
			},
			cookie: { none: 'SameSite=None; Secure', lax: 'SameSite=Lax' }
		},
		pregunta: 'Can the page read the response?',
		si: 'Yes.',
		no: 'No.',
		opacaRes: 'No. It gets an opaque response: no status and no body.',
		detalle: 'What the browser and the server exchange',
		codigo: 'Page code',
		previa: '1. Preflight request (OPTIONS)',
		previaNo: 'Not needed: it is a simple request (section 3).',
		real: '2. Request',
		realNo: 'Not sent.',
		enviada: 'The browser sends',
		recibida: 'The server answers',
		sinCors: '(no CORS headers)',
		conCookie: 'Cookie: sesion=…',
		sinCookie: '(no cookie)',
		sinOrigin: '(no Origin header)',
		consola: 'Error in the Chrome console',
		estados: {
			perfilOk: '200: returns the profile',
			pedidoOk: '200: saves the order',
			sinSesion: '401: no session',
			previa: '204'
		},
		notas: {
			robo: "Another site has read the user's data with their session. This is the failure from section 6.",
			csrf: "The order was saved with the user's session, even though the other site cannot read the response. CORS does not prevent CSRF (section 7).",
			propioSinLeer: 'The order was saved, but your frontend cannot read the response.',
			llego: 'The request reached the server. It was the browser that did not let the page read the response.',
			noLlego: 'The preflight request failed, so the real request was never sent.',
			opaca: 'The request reached the server, but the page cannot use the response.',
			typeError: "fetch fails before sending anything: that method is not allowed in mode: 'no-cors'.",
			correcta: 'Your frontend reads the response.',
			ajenoSinSesion: 'The other site reads the response, but without the session cookie the API only returns 401.',
			publica: 'Any site reads the response. This is only suitable for public data.'
		},
		casos: [
			{
				id: 'error',
				nombre: 'The CORS error',
				mirar: 'The server receives the request and answers 200, but sends no CORS headers. The browser does not let the page read the response.',
				valores: { pagina: 'http://localhost:5173', peticion: 'get', credenciales: 'same-origin', modo: 'cors', config: 'sin', cookie: 'none' }
			},
			{
				id: 'previa',
				nombre: 'The preflight request',
				mirar: 'With JSON, the browser asks first with OPTIONS. Since the server does not answer it properly, the POST is never sent.',
				valores: { pagina: 'http://localhost:5173', peticion: 'post-json', credenciales: 'same-origin', modo: 'cors', config: 'sin', cookie: 'none' }
			},
			{
				id: 'correcta',
				nombre: 'The correct configuration',
				mirar: 'The server only allows your frontend and accepts cookies. The preflight request passes and the page reads the response.',
				valores: { pagina: 'http://localhost:5173', peticion: 'post-json', credenciales: 'include', modo: 'cors', config: 'lista-cred', cookie: 'none' }
			},
			{
				id: 'robo',
				nombre: 'Another site reads your data',
				mirar: "The server returns any Origin with cookies. A foreign site reads the user's profile with their session.",
				valores: { pagina: 'http://127.0.0.1:8080', peticion: 'get', credenciales: 'include', modo: 'cors', config: 'reflejo', cookie: 'none' }
			},
			{
				id: 'lax',
				nombre: 'SameSite=Lax stops it',
				mirar: 'The same insecure server, but the cookie is SameSite=Lax. From another site the cookie is not sent and the API answers 401.',
				valores: { pagina: 'http://127.0.0.1:8080', peticion: 'get', credenciales: 'include', modo: 'cors', config: 'reflejo', cookie: 'lax' }
			},
			{
				id: 'csrf',
				nombre: 'CORS does not stop CSRF',
				mirar: "The server is configured correctly and the other site cannot read the response. Even so, the order is saved with the user's session.",
				valores: { pagina: 'http://localhost:8080', peticion: 'post-texto', credenciales: 'include', modo: 'cors', config: 'lista-cred', cookie: 'none' }
			}
		] as Caso[]
	}
}[lang];

const nombresCampos = ['pagina', 'peticion', 'credenciales', 'modo', 'config', 'cookie'] as const;
const inicial = T.casos[0];
---

<section class="cors-sim" data-textos={JSON.stringify(T)} aria-labelledby={`cors-sim-titulo-${lang}`}>
	<p class="cors-sim-titulo" id={`cors-sim-titulo-${lang}`}>{T.titulo}</p>
	<p class="cors-sim-intro">{T.intro}</p>

	<p class="cors-sim-etiqueta">{T.casosTitulo}</p>
	<div class="cors-sim-casos" role="group" aria-label={T.casosTitulo}>
		{
			T.casos.map((c, i) => (
				<button type="button" class="cors-sim-caso" data-caso={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>
					{c.nombre}
				</button>
			))
		}
	</div>
	<p class="cors-sim-mirar">{inicial.mirar}</p>

	<details class="cors-sim-opciones">
		<summary>{T.opcionesTitulo}</summary>
		<form class="cors-sim-campos" onsubmit="return false">
			{
				nombresCampos.map((n) => (
					<label class="cors-sim-campo">
						<span>{T.campos[n]}</span>
						<select name={n}>
							{Object.entries(T.opciones[n]).map(([valor, texto]) => (
								<option value={valor} selected={valor === inicial.valores[n]}>
									{texto}
								</option>
							))}
						</select>
					</label>
				))
			}
		</form>
	</details>

	<div class="cors-sim-salida" aria-live="polite"></div>
</section>

<script>
	import { simular, type Entrada, type Resultado, type Envio } from '../lib/cors-simulador';

	const CAMPOS = ['pagina', 'peticion', 'credenciales', 'modo', 'config', 'cookie'] as const;
	const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	const pre = (s: string) => `<pre class="cors-sim-pre">${esc(s)}</pre>`;

	function cabeceras(h: Record<string, string>, vacio: string): string {
		const filas = Object.entries(h).map(([k, v]) => `${k}: ${v}`);
		return filas.length ? filas.join('\n') : vacio;
	}

	function codigo(e: Entrada): string {
		const ruta = e.peticion.startsWith('get') ? '/perfil' : '/pedido';
		const o: string[] = [];
		if (e.peticion === 'put-json') o.push(`method: 'PUT'`);
		if (e.peticion.startsWith('post')) o.push(`method: 'POST'`);
		if (e.peticion === 'post-texto') o.push(`headers: { 'Content-Type': 'text/plain' }`, `body: 'hola'`);
		if (e.peticion === 'post-json' || e.peticion === 'put-json')
			o.push(`headers: { 'Content-Type': 'application/json' }`, `body: '{"a":1}'`);
		if (e.peticion === 'get-auth') o.push(`headers: { Authorization: 'Bearer …' }`);
		if (e.credenciales === 'include') o.push(`credentials: 'include'`);
		if (e.modo === 'no-cors') o.push(`mode: 'no-cors'`);
		const args = o.length ? `, {\n  ${o.join(',\n  ')}\n}` : '';
		return `// ${e.pagina}\nawait fetch('http://localhost:3000${ruta}'${args});`;
	}

	function envio(v: Envio, T: any): string {
		const l = [`${v.metodo} ${v.ruta}`, v.origin ? `Origin: ${v.origin}` : T.sinOrigin];
		for (const [k, val] of Object.entries(v.cabeceras)) l.push(`${k}: ${val}`);
		if (v.metodo !== 'OPTIONS') l.push(v.cookie ? T.conCookie : T.sinCookie);
		return l.join('\n');
	}

	function estado(e: Entrada, r: NonNullable<Resultado['real']>, T: any): string {
		if (!r.envio.cookie) return T.estados.sinSesion;
		return e.peticion.startsWith('get') ? T.estados.perfilOk : T.estados.pedidoOk;
	}

	function nota(e: Entrada, r: Resultado, T: any): { tipo: 'riesgo' | 'correccion' | 'nota'; texto: string } {
		const cookie = !!r.real?.envio.cookie;
		const escritura = !e.peticion.startsWith('get');
		const ajeno = e.pagina !== 'http://localhost:5173';
		if (r.error && !r.previa && !r.real) return { tipo: 'nota', texto: T.notas.typeError };
		if (r.leida && cookie && ajeno) return { tipo: 'riesgo', texto: T.notas.robo };
		if (r.real && !r.leida && cookie && escritura) {
			return ajeno ? { tipo: 'riesgo', texto: T.notas.csrf } : { tipo: 'nota', texto: T.notas.propioSinLeer };
		}
		if (r.previa && !r.real) return { tipo: 'nota', texto: T.notas.noLlego };
		if (r.opaca) return { tipo: 'nota', texto: T.notas.opaca };
		if (r.real && !r.leida) return { tipo: 'nota', texto: T.notas.llego };
		if (r.leida && r.real?.respuesta['Access-Control-Allow-Origin'] === '*') return { tipo: 'nota', texto: T.notas.publica };
		if (r.leida && ajeno) return { tipo: 'nota', texto: T.notas.ajenoSinSesion };
		return { tipo: 'correccion', texto: T.notas.correcta };
	}

	function par(v: Envio, respuesta: string, T: any): string {
		return `<div class="cors-sim-par"><div><p class="cors-sim-sub">${T.enviada}</p>${pre(envio(v, T))}</div><div><p class="cors-sim-sub">${T.recibida}</p>${pre(respuesta)}</div></div>`;
	}

	function pintar(raiz: HTMLElement, T: any) {
		const form = raiz.querySelector('form')!;
		const campo = (n: string) => form.elements.namedItem(n) as HTMLSelectElement;
		const e = Object.fromEntries(CAMPOS.map((n) => [n, campo(n).value])) as unknown as Entrada;
		campo('cookie').disabled = e.credenciales !== 'include';
		const r = simular(e);
		const n = nota(e, r, T);
		const sinEnvio = !!r.error && !r.previa && !r.real;

		const respuesta = r.leida ? T.si : r.opaca ? T.opacaRes : T.no;
		let html = `<div class="cors-sim-veredicto" data-tipo="${n.tipo}">
			<p class="cors-sim-pregunta">${T.pregunta}</p>
			<p class="cors-sim-respuesta">${esc(respuesta)} ${esc(n.texto)}</p>
			${r.consola ? `<p class="cors-sim-sub">${T.consola}</p>${pre(r.consola)}` : ''}
			${sinEnvio ? pre(r.error!) : ''}
		</div>`;

		html += `<p class="cors-sim-etiqueta">${T.detalle}</p>`;
		html += `<p class="cors-sim-sub">${T.codigo}</p>${pre(codigo(e))}`;
		if (!sinEnvio) {
			html += `<p class="cors-sim-paso-titulo">${T.previa}</p>`;
			html += r.previa
				? par(r.previa.envio, `${T.estados.previa}\n${cabeceras(r.previa.respuesta, T.sinCors)}`, T)
				: `<p class="cors-sim-texto">${T.previaNo}</p>`;
			html += `<p class="cors-sim-paso-titulo">${T.real}</p>`;
			html += r.real
				? par(r.real.envio, `${estado(e, r.real, T)}\n${cabeceras(r.real.respuesta, T.sinCors)}`, T)
				: `<p class="cors-sim-texto">${T.realNo}</p>`;
		}
		raiz.querySelector('.cors-sim-salida')!.innerHTML = html;
	}

	for (const raiz of document.querySelectorAll<HTMLElement>('.cors-sim')) {
		const T = JSON.parse(raiz.dataset.textos!);
		const form = raiz.querySelector('form')!;
		const mirar = raiz.querySelector('.cors-sim-mirar')!;
		const botones = [...raiz.querySelectorAll<HTMLButtonElement>('.cors-sim-caso')];

		const marcar = (id: string | null) => {
			for (const b of botones) b.setAttribute('aria-pressed', String(b.dataset.caso === id));
			mirar.textContent = id ? T.casos.find((c: any) => c.id === id).mirar : T.propio;
		};

		for (const b of botones) {
			b.addEventListener('click', () => {
				const caso = T.casos.find((c: any) => c.id === b.dataset.caso);
				for (const n of CAMPOS) (form.elements.namedItem(n) as HTMLSelectElement).value = caso.valores[n];
				marcar(caso.id);
				pintar(raiz, T);
			});
		}
		form.addEventListener('change', () => {
			marcar(null);
			pintar(raiz, T);
		});
		pintar(raiz, T);
	}
</script>
