---
import { buildGraph } from '../lib/jsonld';
import { seo, type SeoInput } from '../lib/seo';
import { t } from '../lib/i18n';

type Props = SeoInput;

const {
	lang,
	key,
	slug,
	title,
	description,
	image = null,
	noindex = false,
	published = null,
	updated = null
} = Astro.props;

const tags = seo({ lang, key, slug, title, description, image, noindex });
const siteName = t(lang).meta.siteName;

const graph = await buildGraph({
	lang,
	key,
	slug,
	title,
	description,
	canonical: tags.canonical,
	ogImage: tags.ogImage,
	noindex
});
---

<title>{title}</title>
<meta name="description" content={description} />

{
	noindex ? (
		<meta name="robots" content="noindex, follow" />
	) : (
		<>
			<link rel="canonical" href={tags.canonical} />
			{tags.alternates.map((alternate) => (
				<link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
			))}
		</>
	)
}

<meta
	property="og:type"
	content={key === 'project' || key === 'article' ? 'article' : 'website'}
/>
{published && <meta property="article:published_time" content={published} />}
{(updated || published) && (
	<meta property="article:modified_time" content={updated ?? published} />
)}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={tags.ogLocale} />
<meta property="og:locale:alternate" content={tags.ogLocaleAlternate} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={tags.canonical} />}
{
	tags.ogImage && (
		<>
			<meta property="og:image" content={tags.ogImage} />
			<meta property="og:image:width" content="1200" />
			<meta property="og:image:height" content="630" />
			<meta property="og:image:type" content="image/png" />
			<meta property="og:image:alt" content={title} />
			<meta name="twitter:card" content="summary_large_image" />
			<meta name="twitter:title" content={title} />
			<meta name="twitter:description" content={description} />
			<meta name="twitter:image" content={tags.ogImage} />
			<meta name="twitter:image:alt" content={title} />
		</>
	)
}

{graph && <script type="application/ld+json" is:inline set:html={graph} />}
