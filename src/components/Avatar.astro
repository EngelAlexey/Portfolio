---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
	alt: string;
	size?: number;
}

const { alt, size = 128 } = Astro.props;

const PHOTO = '/img/alex.jpg';
const hasPhoto = existsSync(join(process.cwd(), 'public', PHOTO));
---

{
	hasPhoto ? (
		<img
			class="avatar"
			src={PHOTO}
			alt={alt}
			width={size}
			height={size}
			style={`--size: ${size}px`}
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	) : (
		<span class="avatar monogram" style={`--size: ${size}px`} role="img" aria-label={alt}>
			AH
		</span>
	)
}

<style>
	.avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--size, 128px);
		height: var(--size, 128px);
		border-radius: var(--radius);
		border: 1px solid var(--line);
		object-fit: cover;
		background: var(--paper-sunken);
	}

	.monogram {
		font-family: var(--font-mono);
		font-size: calc(var(--size) * 0.3);
		letter-spacing: 0.02em;
		color: var(--ink-faint);
		user-select: none;
	}
</style>
