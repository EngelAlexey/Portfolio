---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

/**
 * Draws the photo when `public/img/alex.jpg` is there and a monogram when it is
 * not, decided at build time. The previous version took a `hasPhoto` prop that
 * no caller ever passed, so the monogram was the only branch that could ever
 * render — dropping the file in would have changed nothing.
 */
interface Props {
	alt: string;
	size?: number;
}

const { alt, size = 128 } = Astro.props;

const PHOTO = '/img/alex.jpg';
// Resolved from the project root, not from `import.meta.url`: this component is
// bundled before it runs, so a path relative to the module lands in the build
// output rather than in `src/`.
const hasPhoto = existsSync(join(process.cwd(), 'public', PHOTO));
---

{
	hasPhoto ? (
		<img
			class="avatar"
			src={PHOTO}
			alt={alt}
			width={size}
			height={size}
			style={`--size: ${size}px`}
			loading="lazy"
			decoding="async"
		/>
	) : (
		<span class="avatar monogram" style={`--size: ${size}px`} role="img" aria-label={alt}>
			AH
		</span>
	)
}

<style>
	.avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--size, 128px);
		height: var(--size, 128px);
		border-radius: var(--radius);
		border: 1px solid var(--line);
		object-fit: cover;
		background: var(--paper-sunken);
	}

	.monogram {
		font-family: var(--font-mono);
		font-size: calc(var(--size) * 0.3);
		letter-spacing: 0.02em;
		color: var(--ink-faint);
		user-select: none;
	}
</style>
