---
import { other, path, t, type Lang, type RouteKey } from '../lib/i18n';

interface Props {
	lang: Lang;
	routeKey: RouteKey;
	slug?: string;
	slugs?: Record<Lang, string>;
}

const { lang, routeKey, slug, slugs } = Astro.props;

// El segmento del otro idioma no siempre es el mismo: un articulo lo traduce.
const target = slugs ? slugs[other(lang)] : slug;
const href = path(other(lang), routeKey, target);
const strings = t(lang).a11y;
---

<a {href} class="switch" hreflang={other(lang)} aria-label={strings.langSwitch}>
	{strings.langSwitchShort}
</a>

<style>
	.switch {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 2.25rem;
		padding-inline: 0.7rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-decoration: none;
		transition:
			color 120ms ease,
			border-color 120ms ease;
	}

	.switch:hover {
		color: var(--ink);
		border-color: var(--line-strong);
	}
</style>
