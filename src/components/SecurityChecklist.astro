					{ id: 'perm-rol', texto: "An admin action, requested with a regular user's session, answers 403." },
					{ id: 'perm-id', texto: "A resource from another account, requested by its id, answers 404." }
				]
			},
			{
				id: 'entrada', nombre: '6. Input and output', ancla: '#8-how-to-handle-input-and-output',
				puntos: [
					{ id: 'ent-comilla', texto: 'A single quote in a search field does not produce a 500 error.' },
					{ id: 'ent-xss', texto: 'Text such as <img src=x onerror=alert(1)> in the search is shown as text.' }
				]
			},
			{
				id: 'origenes', nombre: '7. Other origins (CORS and CSRF)', ancla: '#9-how-to-control-requests-from-other-origins',
				puntos: [
					{ id: 'ori-cors', texto: 'A request with a foreign Origin gets no Access-Control-Allow-Origin.', orden: 'curl -si -H "Origin: https://atacante.example" https://your-domain.example/api/perfil' },
					{ id: 'ori-csrf', texto: "Routes that change data require an anti-CSRF token or the framework's protection." }
				]
			},
			{
				id: 'secretos', nombre: '8. Secrets', ancla: '#10-how-to-keep-secrets-out-of-the-code-and-the-browser',
				puntos: [
					{ id: 'sec-bundle', texto: 'No private key appears in the JavaScript the browser downloads.' },
					{ id: 'sec-git', texto: 'The .env file is not in the repository.', orden: 'git ls-files .env' }
				]
			},
			{
				id: 'dependencias', nombre: '9. Dependencies', ancla: '#11-how-to-control-dependencies',
				puntos: [
					{ id: 'dep-ci', texto: 'The install uses the lockfile.', orden: 'npm ci' },
					{ id: 'dep-firmas', texto: 'The signatures of the installed packages are verified.', orden: 'npm audit signatures' }
				]
			},
			{
				id: 'errores', nombre: '10. Errors and logs', ancla: '#12-how-to-answer-errors-without-leaking-data',
				puntos: [
					{ id: 'err-traza', texto: 'A 500 error returns an identifier, with no stack trace or internal data.' },
					{ id: 'err-log', texto: 'The server log does not store passwords, session cookies or tokens.' }
				]
			}
		] as Capa[]
	}
}[lang];

const total = T.capas.reduce((n, c) => n + c.puntos.length, 0);
---

<section class="sec-check" data-total={total} data-lang={lang} aria-labelledby={`sec-check-titulo-${lang}`}>
	<div class="sec-check-cabecera">
		<p class="sec-check-titulo" id={`sec-check-titulo-${lang}`}>{T.titulo}</p>
		<p class="sec-check-progreso" aria-live="polite" data-plantilla-es="{n} de {m} comprobados" data-plantilla-en="{n} of {m} checked">
			{T.progreso(0, total)}
		</p>
	</div>
	<p class="sec-check-intro">{T.intro}</p>
	{
		T.capas.map((capa) => (
			<fieldset class="sec-check-capa">
				<legend>
					{capa.nombre} <a href={capa.ancla}>{T.irA}</a>
				</legend>
				{capa.puntos.map((p) => (
					<label class="sec-check-punto">
						<input type="checkbox" data-id={p.id} />
						<span>
							{p.texto}
							{p.orden && <code class="sec-check-orden">{p.orden}</code>}
						</span>
					</label>
				))}
			</fieldset>
		))
	}
	<button type="button" class="sec-check-reiniciar">{T.reiniciar}</button>
</section>

<script>
	const CLAVE = 'sec-check:como-proteger-una-pagina-web';

	function leer(): Record<string, boolean> {
		try {
			return JSON.parse(localStorage.getItem(CLAVE) ?? '{}');
		} catch {
			return {};
		}
	}

	function guardar(estado: Record<string, boolean>) {
		try {
			localStorage.setItem(CLAVE, JSON.stringify(estado));
		} catch {
			// Sin almacenamiento (ventana privada o bloqueado): la lista funciona igual, sin recordar.
		}
	}

	for (const raiz of document.querySelectorAll<HTMLElement>('.sec-check')) {
		const casillas = [...raiz.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
		const progreso = raiz.querySelector<HTMLElement>('.sec-check-progreso')!;
		const plantilla = progreso.dataset[raiz.dataset.lang === 'en' ? 'plantillaEn' : 'plantillaEs']!;
		const total = Number(raiz.dataset.total);

		const pintar = () => {
			const n = casillas.filter((c) => c.checked).length;
			progreso.textContent = plantilla.replace('{n}', String(n)).replace('{m}', String(total));
		};

		const estado = leer();
		for (const c of casillas) {
			c.checked = !!estado[c.dataset.id!];
			c.addEventListener('change', () => {
				const actual = leer();
				actual[c.dataset.id!] = c.checked;
				guardar(actual);
				pintar();
			});
		}
		raiz.querySelector('.sec-check-reiniciar')!.addEventListener('click', () => {
			for (const c of casillas) c.checked = false;
			guardar({});
			pintar();
		});
		pintar();
	}
</script>
