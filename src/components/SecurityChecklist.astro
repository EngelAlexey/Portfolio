					{ id: 'ses-js', texto: 'With the session started, document.cookie in the console does not show the session cookie.' }
				]
			},
			{
				id: 'contrasenas', nombre: '4. Passwords and attempts', ancla: '#6-how-to-store-passwords-and-limit-attempts',
				puntos: [
