---
// Lista de comprobación del artículo como-proteger-una-pagina-web. Las capas siguen el
// mismo orden y los mismos nombres que la tabla del punto 1 y la fase 2 del prompt.
// El estado se guarda en localStorage solo como comodidad para quien lee.
// Los estilos están en src/app.css (.sec-check): un componente importado desde un .mdx
// no recibe su CSS con ámbito.
interface Props {
	lang: 'es' | 'en';
}

const { lang } = Astro.props;

type Punto = { id: string; texto: string; orden?: string };
type Capa = { id: string; nombre: string; ancla: string; puntos: Punto[] };

const T = {
