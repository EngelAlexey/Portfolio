		intro: 'Tick each item after checking it on your application. Replace your-domain.example with your own.',
		progreso: (n: number, m: number) => `${n} of ${m} checked`,
		reiniciar: 'Untick all',
		irA: 'See the section',
		capas: [
			{
				id: 'https', nombre: '1. HTTPS', ancla: '#3-how-to-serve-the-application-over-https-and-enable-hsts',
				puntos: [
					{ id: 'https-redir', texto: 'The http:// address redirects to https://.', orden: 'curl -sI http://your-domain.example' },
					{ id: 'https-hsts', texto: 'The HTTPS response carries Strict-Transport-Security with a max-age of at least one year (OWASP recommends two).', orden: 'curl -sI https://your-domain.example' }
