---
import { path, t, type Lang } from '../lib/i18n';

interface Props {
	lang: Lang;
	gaId: string | null;
}

const { lang, gaId } = Astro.props;
const text = t(lang).cookies;
---

<section
	class="notice"
	aria-labelledby="cookie-notice-title"
	data-cookie-notice
	data-ga={gaId ?? undefined}
	data-saved-granted={text.savedGranted}
	data-saved-denied={text.savedDenied}
	hidden
>
	<h2 id="cookie-notice-title">{text.title}</h2>
	<p>{text.body}</p>
	<a class="more" href={path(lang, 'privacy')}>{text.more}</a>
	<div class="actions">
		<button type="button" class="btn" data-cookie-reject>{text.reject}</button>
		<button type="button" class="btn" data-cookie-accept>{text.accept}</button>
	</div>
</section>
<p class="sr-only" role="status" data-cookie-status></p>

<style>
	.notice {
		position: fixed;
		z-index: 60;
		inset-inline: 0.75rem;
		bottom: 0.75rem;
		max-width: 26rem;
		padding: 1rem 1.15rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--ink);
		box-shadow: var(--shadow-card);
	}

	.notice[hidden] {
		display: none;
	}

	@media (min-width: 40rem) {
		.notice {
			inset-inline: auto;
			right: 1.25rem;
			bottom: 1.25rem;
		}
	}

	h2 {
		margin: 0 0 0.35rem;
		font-size: 1rem;
		font-weight: 600;
	}

	p {
		margin: 0 0 0.5rem;
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.more {
		font-size: 0.8125rem;
		color: var(--ink-muted);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition:
			color 120ms ease,
			text-decoration-color 120ms ease;
	}

	.more:hover,
	.more:focus-visible {
		color: var(--ink);
		text-decoration-color: currentColor;
	}

	@media (prefers-reduced-motion: reduce) {
		.more {
			transition: none;
		}
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.85rem;
	}

	.actions .btn {
		flex: 1 1 auto;
		justify-content: center;
		padding-inline: 0.75rem;
	}
</style>

<script>
	import { loadAnalytics, stopAnalytics } from '../lib/analytics';
	import { CONSENT_KEY, parseDecision, serializeDecision, type Decision } from '../lib/consent';

	const notice = document.querySelector<HTMLElement>('[data-cookie-notice]');
	const status = document.querySelector<HTMLElement>('[data-cookie-status]');

	function tracking(): boolean {
		try {
			return localStorage.getItem('notrack') !== '1';
		} catch {
			return true;
		}
	}

	if (notice) {
		const gaId = notice.dataset['ga'] ?? null;
		let memory: Decision | null = null;
		let opener: HTMLElement | null = null;

		const read = (): Decision | null => {
			try {
				return parseDecision(localStorage.getItem(CONSENT_KEY));
			} catch {
				return memory;
			}
		};

		const write = (decision: Decision): void => {
			memory = decision;
			try {
				localStorage.setItem(CONSENT_KEY, serializeDecision(decision, Date.now()));
			} catch {}
		};

		const render = (decision: Decision | null): void => {
			const key = decision === 'granted' ? 'granted' : decision === 'denied' ? 'denied' : 'none';
			for (const element of document.querySelectorAll<HTMLElement>('[data-cookie-state]')) {
				element.textContent = element.dataset[key] ?? '';
			}
		};

		const apply = (decision: Decision | null): void => {
			if (decision === 'granted' && gaId !== null && tracking()) loadAnalytics(gaId);
			if (decision === 'denied') stopAnalytics(gaId);
		};

		const show = (focus: boolean): void => {
			notice.hidden = false;
			if (focus) notice.querySelector<HTMLElement>('[data-cookie-accept]')?.focus();
		};

		const hide = (): void => {
			notice.hidden = true;
			opener?.focus();
			opener = null;
		};

		const choose = (decision: Decision): void => {
			write(decision);
			apply(decision);
			render(decision);
			hide();
			if (status) {
				status.textContent =
					(decision === 'granted' ? notice.dataset['savedGranted'] : notice.dataset['savedDenied']) ?? '';
			}
		};

		const initial = read();
		apply(initial);
		render(initial);
		if (initial === null && tracking()) show(false);

		notice.querySelector('[data-cookie-accept]')?.addEventListener('click', () => choose('granted'));
		notice.querySelector('[data-cookie-reject]')?.addEventListener('click', () => choose('denied'));

		notice.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && read() !== null) hide();
		});

		document.addEventListener('click', (event) => {
			const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-cookie-settings]') : null;
			if (target === null) return;
			opener = target;
			show(true);
		});
	}
</script>
