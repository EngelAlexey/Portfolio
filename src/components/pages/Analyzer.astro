---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../Container.astro';
import { LIMITS } from '../../lib/analyzer/limits';
import { t, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.analyzer;

const entries = (await getCollection('analyzer')).filter((entry) => entry.id.endsWith(`/${lang}`));
const explanations = await Promise.all(
	entries.map(async (entry) => ({
		codes: entry.data.codes,
		sources: entry.data.sources,
		Content: (await render(entry)).Content
	}))
);

const payload = {
	findings: text.findings,
	status: text.status,
	result: text.result,
	sample: text.sample
};
---

<Layout {lang} key="analyzer" title={strings.meta.titleTemplate(text.title)} description={text.description}>
	<Container as="header" size="text">
		<div class="head">
			<h1>{text.title}</h1>
			<p>{text.lead}</p>
		</div>
	</Container>

	<Container size="text">
		<div data-analyzer data-strings={JSON.stringify(payload)} data-limit={LIMITS.links}>
			<form data-form novalidate>
				<div class="field">
					<label for="analyzer-message">{text.form.messageLabel}</label>
					<textarea id="analyzer-message" name="message" rows="7" spellcheck="false" autocomplete="off"></textarea>
					<p class="hint">{text.form.messageHint}</p>
				</div>

				<div class="field">
					<label for="analyzer-links">{text.form.linksLabel}</label>
					<textarea id="analyzer-links" name="links" rows="3" spellcheck="false" autocomplete="off"></textarea>
					<p class="hint">{text.form.linksHint}</p>
					<details class="how">
						<summary>{text.form.copyTitle}</summary>
						<ul class="plain">
							{text.form.copySteps.map((step) => <li>{step}</li>)}
						</ul>
					</details>
				</div>

				<div class="field">
					<label for="analyzer-sender">{text.form.senderLabel}</label>
					<input id="analyzer-sender" name="sender" type="text" spellcheck="false" autocomplete="off" />
					<p class="hint">{text.form.senderHint}</p>
				</div>

				<details class="advanced">
					<summary>{text.form.advancedTitle}</summary>
					<div class="field">
						<label for="analyzer-headers">{text.form.headersLabel}</label>
						<textarea id="analyzer-headers" name="headers" rows="6" spellcheck="false" autocomplete="off" class="mono"></textarea>
						<p class="hint">{text.form.headersHint}</p>
					</div>
				</details>

				<div class="actions">
					<button type="submit" class="btn primary" data-analyse>{text.form.analyse}</button>
					<button type="button" class="btn" data-example>{text.form.example}</button>
					<button type="reset" class="btn" data-clear>{text.form.clear}</button>
				</div>
				<p class="status" role="status" data-status></p>
			</form>

			<div class="result" data-result hidden></div>

			<div hidden>
				{
					explanations.map((item) => (
						<template data-explanation data-codes={item.codes.join(' ')}>
							<item.Content />
							<p class="sources-title">{text.result.sources}</p>
							<ul class="sources">
								{item.sources.map((source) => (
									<li>
										<a href={source.url} rel="noreferrer" target="_blank">
											{source.text}
										</a>
									</li>
								))}
							</ul>
						</template>
					))
				}
			</div>
		</div>
	</Container>
</Layout>

<style>
	.head {
		padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.head p {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	[data-analyzer] {
		padding-bottom: 4rem;
	}

	.field {
		display: grid;
		gap: 0.35rem;
		margin-bottom: 1.25rem;
	}

	label {
		font-size: 0.9375rem;
		font-weight: 500;
	}

	textarea,
	input[type='text'] {
		width: 100%;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 1rem;
		line-height: 1.5;
	}

	textarea {
		resize: vertical;
	}

	textarea.mono {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	textarea:focus-visible,
	input[type='text']:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 1px;
	}

	.hint {
		margin: 0;
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.how,
	.advanced {
		font-size: 0.9375rem;
	}

	.how summary,
	.advanced summary {
		cursor: pointer;
		color: var(--ink-muted);
	}

	.advanced {
		margin-bottom: 1.25rem;
	}

	.advanced .field {
		margin-top: 0.85rem;
		margin-bottom: 0;
	}

	.plain {
		margin: 0.5rem 0 0;
		padding-left: 1.25rem;
		color: var(--ink-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.btn {
		cursor: pointer;
		background: var(--surface);
		font-family: inherit;
	}

	.btn.primary {
		background: var(--action);
	}

	.btn:disabled {
		cursor: progress;
		opacity: 0.6;
	}

	.status {
		min-height: 1.5rem;
		margin: 0.85rem 0 0;
		font-size: 0.9375rem;
		color: var(--ink-muted);
	}

	.result {
		margin-top: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.result :global(h2) {
		margin: 0 0 0.5rem;
		font-size: 1.3125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.result :global(h2:focus) {
		outline: none;
	}

	.result :global(.summary) {
		margin: 0 0 1.5rem;
		font-size: 1.0625rem;
	}

	.result :global(.group) {
		margin-bottom: 2rem;
	}

	.result :global(h3) {
		margin: 0 0 0.75rem;
		font-size: 1.0625rem;
		font-weight: 600;
	}

	.result :global(.finding) {
		margin-bottom: 0.75rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-left: 3px solid var(--sev-info);
		border-radius: var(--radius-sm);
		background: var(--surface);
	}

	.result :global(.finding[data-severity='critical']) {
		border-left-color: var(--sev-critical);
	}

	.result :global(.finding[data-severity='high']) {
		border-left-color: var(--sev-high);
	}

	.result :global(.finding[data-severity='medium']) {
		border-left-color: var(--sev-medium);
	}

	.result :global(.finding[data-severity='low']) {
		border-left-color: var(--sev-low);
	}

	.result :global(.finding header) {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
	}

	.result :global(.severity) {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.result :global(.finding h4) {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
	}

	.result :global(.evidence) {
		margin: 0.6rem 0 0;
		font-size: 0.875rem;
	}

	.result :global(.evidence > div) {
		display: grid;
		grid-template-columns: minmax(6rem, max-content) 1fr;
		gap: 0.75rem;
		padding-block: 0.15rem;
	}

	.result :global(.evidence dt) {
		color: var(--ink-faint);
	}

	.result :global(.evidence dd) {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		overflow-wrap: anywhere;
	}

	.result :global(.explain) {
		margin-top: 0.6rem;
		font-size: 0.9375rem;
	}

	.result :global(.explain summary) {
		cursor: pointer;
		color: var(--ink-muted);
	}

	.result :global(.explanation) {
		margin-top: 0.5rem;
		line-height: 1.6;
	}

	.result :global(.explanation h2) {
		margin: 1rem 0 0.25rem;
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.result :global(.explanation p),
	.result :global(.explanation ul) {
		margin: 0 0 0.6rem;
	}

	.result :global(.explanation code) {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.result :global(.sources-title) {
		margin-top: 1rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.result :global(.sources) {
		margin: 0;
		padding-left: 1.25rem;
		font-size: 0.8125rem;
	}

	.result :global(.sources a) {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.result :global(.plain) {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--ink);
		line-height: 1.6;
	}

	.result :global(.closing) {
		margin: 0;
		font-weight: 600;
	}

	@media (max-width: 40rem) {
		.result :global(.evidence > div) {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>

<script>
	import { analyse, fill, renderReport, type ClientStrings } from '../../lib/analyzer/client';
	import { linksFromHtml } from '../../lib/analyzer/clipboard';
	import type { MessageLink } from '../../lib/analyzer/types';

	const root = document.querySelector<HTMLElement>('[data-analyzer]');

	if (root) {
		const strings = JSON.parse(root.dataset['strings'] ?? '{}') as ClientStrings;
		const limit = root.dataset['limit'] ?? '';
		const form = root.querySelector<HTMLFormElement>('[data-form]');
		const result = root.querySelector<HTMLElement>('[data-result]');
		const status = root.querySelector<HTMLElement>('[data-status]');
		const submit = root.querySelector<HTMLButtonElement>('[data-analyse]');
		const message = root.querySelector<HTMLTextAreaElement>('#analyzer-message');
		const links = root.querySelector<HTMLTextAreaElement>('#analyzer-links');
		const sender = root.querySelector<HTMLInputElement>('#analyzer-sender');
		const headers = root.querySelector<HTMLTextAreaElement>('#analyzer-headers');
		const example = root.querySelector<HTMLButtonElement>('[data-example]');

		const templates = new Map<string, HTMLTemplateElement>();
		for (const template of root.querySelectorAll<HTMLTemplateElement>('template[data-explanation]')) {
			for (const code of (template.dataset['codes'] ?? '').split(' ')) {
				if (code !== '') templates.set(code, template);
			}
		}

		if (form && result && status && submit && message && links && sender && headers && example) {
			let pasted: MessageLink[] = [];

			const say = (value: string): void => {
				status.textContent = value;
			};

			message.addEventListener('paste', (event) => {
				const html = event.clipboardData?.getData('text/html') ?? '';
				if (html !== '') pasted = [...pasted, ...linksFromHtml(html)];
			});

			message.addEventListener('input', () => {
				if (message.value.trim() === '') pasted = [];
			});

			const run = async (): Promise<void> => {
				const text = [message.value, links.value].filter((part) => part.trim() !== '').join('\n');
				if (text.trim() === '' && sender.value.trim() === '' && headers.value.trim() === '') {
					say(strings.status.empty);
					return;
				}
				say(strings.status.working);
				submit.disabled = true;
				try {
					const report = await analyse({ text, links: pasted, sender: sender.value, headers: headers.value });
					const heading = renderReport(result, report, strings, templates);
					result.hidden = false;
					say(report.truncated ? fill(strings.status.truncated, { limit }) : '');
					heading.focus();
				} catch (error) {
					say(error instanceof Error && error.message === 'timeout' ? strings.status.timeout : strings.status.error);
				} finally {
					submit.disabled = false;
				}
			};

			form.addEventListener('submit', (event) => {
				event.preventDefault();
				void run();
			});

			example.addEventListener('click', () => {
				message.value = strings.sample.message;
				links.value = strings.sample.links;
				sender.value = strings.sample.sender;
				headers.value = strings.sample.headers;
				const advanced = root.querySelector<HTMLDetailsElement>('.advanced');
				if (advanced) advanced.open = true;
				pasted = [];
				void run();
			});

			form.addEventListener('reset', () => {
				pasted = [];
				result.hidden = true;
				result.replaceChildren();
				say('');
			});
		}
	}
</script>
