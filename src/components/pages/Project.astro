---
import Layout from '../../layouts/Layout.astro';
import AreaChip from '../AreaChip.astro';
import Container from '../Container.astro';
import Prose from '../Prose.astro';
import StackList from '../StackList.astro';
import { neighbours, renderProject, type Project } from '../../lib/content';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	project: Project;
}

const { lang, project } = Astro.props;

const strings = t(lang);
const meta = project.meta;
const around = await neighbours(lang, meta.slug);
const { Content } = await renderProject(project);

/**
 * `https://www.starcargoservice.com/` → `www.starcargoservice.com`,
 * `https://github.com/EngelAlexey/Guias-Scout` → `github.com/EngelAlexey/Guias-Scout`.
 *
 * A link that reads only "Demo" says nothing about where it lands. Showing the
 * address is also the honest thing on a private project: the reader can see it
 * is a public website and not a back door into somebody's internals.
 */
const address = (url: string): string => {
	const { host, pathname } = new URL(url);
	return pathname === '/' ? host : host + pathname.replace(/\/$/, '');
};

const period =
	meta.period.end === null
		? `${meta.period.start} — ${strings.project.present}`
		: meta.period.start === meta.period.end
			? meta.period.start
			: `${meta.period.start} — ${meta.period.end}`;
---

<Layout
	{lang}
	key="project"
	slug={meta.slug}
	title={strings.meta.titleTemplate(meta.title)}
	description={meta.tagline}
	image={meta.cover}
>
	<Container as="header" size="text">
		<a class="back" href={path(lang, 'projects')}>← {strings.project.back}</a>

		<div class="head">
			<p class="kind">{strings.kind[meta.kind]}</p>
			<h1>{meta.title}</h1>
			<p class="tagline">{meta.tagline}</p>

			<ul class="areas">
				{meta.areas.map((area) => <li><AreaChip {area} {lang} /></li>)}
			</ul>
		</div>
	</Container>

	<Container size="text">
		<dl class="facts">
			{meta.org && <div><dt>{strings.project.org}</dt><dd>{meta.org}</dd></div>}
			{meta.role && <div><dt>{strings.project.role}</dt><dd>{meta.role}</dd></div>}
			<div><dt>{strings.project.period}</dt><dd>{period}</dd></div>
		</dl>

		<div class="stack">
			<h2>{strings.project.stack}</h2>
			<StackList stack={meta.stack} label={strings.project.stack} />
		</div>

		{/*
		  The notice and the links are not alternatives. Client work keeps its
		  source closed and can still have a website anyone may visit, and saying
		  both — "the code is not mine to show, here is the thing itself" — is more
		  use to a reader than either sentence alone.
		*/}
		{
			meta.visibility === 'privado' && (
				<aside class="notice">
					<h2>{strings.project.privateTitle}</h2>
					<p>{strings.project.privateBody}</p>
				</aside>
			)
		}

		{
			(meta.repo || meta.site) && (
				<p class="links">
					{meta.repo && (
						<a href={meta.repo} rel="noreferrer" target="_blank">
							{strings.project.repo} <span class="where">{address(meta.repo)}</span>
						</a>
					)}
					{meta.site && (
						<a href={meta.site} rel="noreferrer" target="_blank">
							{strings.project.site} <span class="where">{address(meta.site)}</span>
						</a>
					)}
				</p>
			)
		}
	</Container>

	<Container size="text">
		{/* The diagram's data lives in front matter, where the schema validates it;
		    the `.mdx` body decides where in the narrative it is drawn. `content.ts`
		    fails the build if a `.md` file declares one, so it can never go
		    unnoticed. */}
		<Prose>
			<Content />
		</Prose>
	</Container>

	<Container size="text">
		<nav class="pager" aria-label={strings.projects.title}>
			{
				around.prev && (
					<a class="prev" href={path(lang, 'project', around.prev.meta.slug)}>
						<span>← {strings.project.previous}</span>
						<strong>{around.prev.meta.title}</strong>
					</a>
				)
			}

			{
				around.next && (
					<a class="next" href={path(lang, 'project', around.next.meta.slug)}>
						<span>{strings.project.next} →</span>
						<strong>{around.next.meta.title}</strong>
					</a>
				)
			}
		</nav>
	</Container>
</Layout>

<style>
	.back {
		display: inline-block;
		margin-top: 2rem;
		font-size: 0.875rem;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.back:hover {
		color: var(--ink);
	}

	.head {
		padding-block: 1.5rem 0.5rem;
	}

	.kind {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--ink-faint);
	}

	h1 {
		margin: 0;
		font-size: clamp(1.875rem, 5vw, 2.75rem);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.tagline {
		margin: 0.75rem 0 0;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.areas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1rem;
		margin: 2rem 0 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
	}

	dt {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-faint);
	}

	dd {
		margin: 0.25rem 0 0;
		font-size: 0.9375rem;
	}

	.stack h2,
	.notice h2 {
		margin: 0 0 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--ink-muted);
	}

	.notice {
		margin-top: 1.75rem;
		padding: 1rem 1.25rem;
		border: 1px dashed var(--line-strong);
		border-radius: var(--radius);
		color: var(--ink-muted);
	}

	.notice p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.75rem;
		margin: 1.75rem 0 0;
		font-size: 0.9375rem;
	}

	/* Ink and a rule, never a brand blue: on this site a hue means an area, and
	   a link is not an area. The underline is what says "this is pressable". */
	.links a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		padding-bottom: 0.2rem;
		border-bottom: 1px solid var(--line-strong);
		color: var(--ink);
		text-decoration: none;
		transition: border-color 0.18s ease;
	}

	.links a:hover {
		border-bottom-color: var(--ink);
	}

	.where {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--ink-faint);
		transition: color 0.18s ease;
	}

	.links a:hover .where {
		color: var(--ink-muted);
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem 1.5rem;
		margin: clamp(2.5rem, 6vw, 4rem) 0 clamp(3rem, 7vw, 5rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		text-decoration: none;
		color: var(--ink-muted);
	}

	.pager a:hover {
		color: var(--ink);
	}

	.pager .next {
		grid-column: 2;
		text-align: right;
	}

	.pager span {
		font-size: 0.75rem;
		font-family: var(--font-mono);
	}

	@media (max-width: 34rem) {
		.pager {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.pager .next {
			grid-column: 1;
			text-align: left;
		}
	}

	.pager strong {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ink);
	}
</style>
