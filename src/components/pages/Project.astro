---
import OrgLink from '../OrgLink.astro';
import Layout from '../../layouts/Layout.astro';
import AreaChip from '../AreaChip.astro';
import Container from '../Container.astro';
import Prose from '../Prose.astro';
import Gallery from '../Gallery.astro';
import StackList from '../StackList.astro';
import { accentStyle } from '../../lib/areas';
import { neighbours, renderProject, type Project } from '../../lib/content';
import { formatPeriod } from '../../lib/format';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
	project: Project;
}

const { lang, project } = Astro.props;

const strings = t(lang);
const meta = project.meta;
const around = await neighbours(lang, meta.slug);
const { Content } = await renderProject(project);

const address = (url: string): string => {
	const { host, pathname } = new URL(url);
	return pathname === '/' ? host : host + pathname.replace(/\/$/, '');
};

const period = formatPeriod(meta.period, strings.project.present);
---

<Layout
	{lang}
	key="project"
	slug={meta.slug}
	title={meta.title}
	description={meta.tagline}
	image={meta.cover}
>
	<div class="ficha" style={accentStyle(meta.areas[0])}>
		<Container as="header" size="text">
			<a class="back" href={path(lang, 'projects')}>← {strings.project.back}</a>

			<div class="head">
				<p class="kind">{strings.kind[meta.kind]}</p>
				<h1>{meta.title}</h1>
				<p class="tagline">{meta.tagline}</p>

				<div class="tags">
					<ul class="areas">
						{meta.areas.map((area) => <li><AreaChip {area} {lang} /></li>)}
					</ul>

					{
						(meta.repo || meta.site || meta.shots) && (
							<p class="links">
								{meta.repo && (
									<a href={meta.repo} rel="noreferrer" target="_blank" title={address(meta.repo)}>
										{strings.project.repo}
									</a>
								)}
								{meta.site && (
									<a href={meta.site} rel="noreferrer" target="_blank" title={address(meta.site)}>
										{strings.project.site}
									</a>
								)}
								{meta.shots && (
									<Gallery
										shots={meta.shots}
										strings={{
											title: strings.project.shots,
											open: strings.project.shotsOpen,
											close: strings.project.shotsClose,
											previous: strings.project.shotsPrevious,
											next: strings.project.shotsNext,
											grid: strings.project.shotsGrid,
											single: strings.project.shotsSingle
										}}
									/>
								)}
							</p>
						)
					}
				</div>
			</div>
		</Container>

		<Container size="text">
			<dl class="facts">
				{meta.org && (
					<div>
						<dt class="meta-label">{strings.project.org}</dt>
						<dd><OrgLink name={meta.org} {lang} /></dd>
					</div>
				)}
				{meta.role && <div><dt class="meta-label">{strings.project.role}</dt><dd>{meta.role}</dd></div>}
				<div><dt class="meta-label">{strings.project.period}</dt><dd>{period}</dd></div>
			</dl>

			<div class="stack">
				<h2 class="meta-label">{strings.project.stack}</h2>
				<StackList stack={meta.stack} label={strings.project.stack} />
			</div>

			{
				meta.visibility === 'privado' && (
					<aside class="notice">
						<h2>{strings.project.privateTitle}</h2>
						<p>{strings.project.privateBody}</p>
					</aside>
				)
			}
		</Container>

		<Container size="text">
			<Prose>
				<Content />
			</Prose>
		</Container>

		<Container size="text">
			<nav class="pager" aria-label={strings.projects.title}>
				{
					around.prev && (
						<a class="prev" href={path(lang, 'project', around.prev.meta.slug)}>
							<span>← {strings.project.previous}</span>
							<strong>{around.prev.meta.title}</strong>
						</a>
					)
				}

				{
					around.next && (
						<a class="next" href={path(lang, 'project', around.next.meta.slug)}>
							<span>{strings.project.next} →</span>
							<strong>{around.next.meta.title}</strong>
						</a>
					)
				}
			</nav>
		</Container>
	</div>
</Layout>

<style>
	.back {
		display: inline-block;
		margin-top: 2rem;
		font-size: 0.875rem;
		color: var(--ink-muted);
		text-decoration: none;
	}

	.back:hover {
		color: var(--ink);
	}

	.head {
		position: relative;
		padding-block: 1.35rem 1.75rem;
	}

	.head::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 3.5rem;
		height: 2px;
		border-radius: 2px;
		background: var(--accent);
	}

	.kind {
		margin: 0 0 0.65rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--accent);
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
		line-height: 1.1;
		text-wrap: pretty;
	}

	.tagline {
		margin: 0.85rem 0 0;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--ink-muted);
		max-width: 40rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.35rem;
	}

	.areas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		gap: 1.1rem;
		margin: 1.75rem 0 1.75rem;
		padding: 1.1rem 0 0;
		border-top: 1px solid var(--line);
	}

	dd {
		margin: 0.3rem 0 0;
		font-size: 0.9375rem;
		line-height: 1.45;
	}

	.stack h2 {
		margin: 0 0 0.7rem;
		font-weight: 500;
	}

	.notice {
		margin-top: 1.75rem;
		padding: 0.95rem 1.15rem;
		border: 1px solid var(--line);
		border-left: 2px solid var(--accent);
		border-radius: var(--radius-sm);
		background: var(--paper-sunken);
	}

	.notice h2 {
		margin: 0 0 0.35rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink);
	}

	.notice p {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.25em 0.6em;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-muted);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.35;
		white-space: nowrap;
		text-decoration: none;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.links a::after {
		content: '↗';
		font-size: 0.9em;
		color: var(--ink-faint);
	}

	.links a:hover,
	.links a:focus-visible {
		color: var(--ink);
		border-color: var(--accent-line);
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem 1.5rem;
		margin: clamp(2.5rem, 6vw, 4rem) 0 clamp(3rem, 7vw, 5rem);
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		text-decoration: none;
		color: var(--ink-muted);
	}

	.pager a:hover {
		color: var(--ink);
	}

	.pager .next {
		grid-column: 2;
		text-align: right;
	}

	.pager span {
		font-size: 0.8125rem;
	}

	@media (max-width: 34rem) {
		.pager {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.pager .next {
			grid-column: 1;
			text-align: left;
		}
	}

	.pager strong {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--ink);
	}
</style>
