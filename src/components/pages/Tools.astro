---
import Layout from '../../layouts/Layout.astro';
import Container from '../Container.astro';
import { path, t, type Lang } from '../../lib/i18n';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.tools;

const items = [
	{ key: 'scanner', href: path(lang, 'scanner'), ...text.items.scanner },
	{ key: 'schemaflow', href: path(lang, 'schemaflow'), ...text.items.schemaflow }
] as const;
---

<Layout {lang} key="tools" title={strings.meta.titleTemplate(text.title)} description={text.lead}>
	<Container as="header">
		<div class="head">
			<h1>{text.title}</h1>
			<p>{text.lead}</p>
		</div>
	</Container>

	<Container>
		<ul class="cards">
			{
				items.map((item) => (
					<li>
						<a class="card" href={item.href}>
							<span class="icon" aria-hidden="true">
								{item.key === 'scanner' ? (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
										<path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6l-7-3Z" />
										<path d="m9 12 2 2 4-4" />
									</svg>
								) : (
									<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
										<rect x="3" y="3" width="7" height="7" rx="1.5" />
										<rect x="14" y="14" width="7" height="7" rx="1.5" />
										<path d="M10 6.5h3.5a2 2 0 0 1 2 2V14" />
									</svg>
								)}
							</span>
							<span class="name">{item.name}</span>
							<span class="body">{item.body}</span>
							<span class="open">
								{text.open}
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" />
								</svg>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</Container>
</Layout>

<style>
	.head {
		padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
	}

	.head > * {
		max-width: 48rem;
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.head p {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: 1rem;
		margin: 0 0 clamp(3rem, 8vw, 5rem);
		padding: 0;
		list-style: none;
	}

	.card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
		box-shadow: var(--shadow-card);
		transition: border-color 120ms ease, transform 120ms ease;
	}

	.card:hover {
		border-color: var(--line-strong);
		transform: translateY(-1px);
	}

	.card:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 0.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--paper-sunken);
		color: var(--ink);
	}

	.name {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.body {
		flex: 1;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
	}

	.open {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.5rem;
		font-size: 0.875rem;
		font-weight: 500;
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none;
		}

		.card:hover {
			transform: none;
		}
	}
</style>
