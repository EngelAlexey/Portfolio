---
import Layout from '../../layouts/Layout.astro';
import Container from '../Container.astro';
import { t, type Lang } from '../../lib/i18n';
import { CV, CV_DEFAULT, CV_VARIANTS, locationLine, PERSON } from '../../lib/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);

const variants = [CV_DEFAULT, ...CV_VARIANTS.filter((v) => v !== CV_DEFAULT)];
const handle = (url: string) => new URL(url).pathname.replace(/\/+$/, '').split('/').pop() ?? url;
const linkedinHandle = handle(PERSON.linkedin);
const githubHandle = handle(PERSON.github);
---

<Layout
	{lang}
	key="contact"
	title={strings.meta.titleTemplate(strings.contact.title)}
	description={strings.contact.lead}
>
	<Container as="header" size="text">
		<div class="head">
			<h1>{strings.contact.title}</h1>
			<p>{strings.contact.lead}</p>
		</div>
	</Container>

	<Container size="text">
		<dl class="channels">
			<div>
				<dt class="label">{strings.contact.email}</dt>
				<dd><a class="value" href={`mailto:${PERSON.email}`}>{PERSON.email}</a></dd>
			</div>
			<div>
				<dt class="label">{strings.contact.linkedin}</dt>
				<dd>
					<a class="value" href={PERSON.linkedin} rel="noreferrer" target="_blank">
						{linkedinHandle}
						<span class="ext" aria-hidden="true">↗</span>
						<span class="sr-only">{strings.a11y.newTab}</span>
					</a>
				</dd>
			</div>
			<div>
				<dt class="label">{strings.contact.github}</dt>
				<dd>
					<a class="value" href={PERSON.github} rel="noreferrer" target="_blank">
						{githubHandle}
						<span class="ext" aria-hidden="true">↗</span>
						<span class="sr-only">{strings.a11y.newTab}</span>
					</a>
				</dd>
			</div>
			<div>
				<dt class="label">{strings.contact.location}</dt>
				<dd class="value plain">{locationLine()}</dd>
			</div>
			<div>
				<dt class="label">{strings.contact.availability}</dt>
				<dd class="value plain">{PERSON.availability[lang]}</dd>
			</div>
		</dl>

		<div class="cv">
			<h2>{strings.contact.cv}</h2>
			<p class="note">{strings.contact.cvNote}</p>
			<div class="cvrow">
				{
					variants.map((variant, i) => (
						<a class:list={['btn', { primary: i === 0 }]} href={CV[variant][lang]} download>
							{strings.contact.cvVariants[variant]}
						</a>
					))
				}
			</div>
		</div>
	</Container>
</Layout>

<style>
	.cvrow {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}
	.head {
		padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.head p {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.channels {
		margin: 0;
		border-top: 1px solid var(--line);
	}

	.channels > div {
		display: grid;
		grid-template-columns: minmax(7rem, max-content) 1fr;
		gap: 1rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--line);
		align-items: baseline;
	}

	.channels dd {
		margin: 0;
	}

	.ext {
		margin-left: 0.15em;
	}

	.label {
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink-faint);
	}

	.value {
		font-size: 0.9375rem;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
		justify-self: start;
	}

	.value:hover {
		border-bottom-color: var(--ink);
	}

	.value.plain {
		border-bottom: 0;
		color: var(--ink-muted);
	}

	.cv {
		margin: 2.25rem 0 clamp(3rem, 7vw, 5rem);
	}

	.cv h2 {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.note {
		margin: 0.3rem 0 1rem;
		font-size: 0.875rem;
		color: var(--ink-faint);
	}

	@media (max-width: 30rem) {
		.channels > div {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
