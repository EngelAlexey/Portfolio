---
import Layout from '../../layouts/Layout.astro';
import Container from '../Container.astro';
import ScannerResult from '../scanner/ScannerResult.astro';
import { path, t, type Lang } from '../../lib/i18n';
import { SCANNER_API, scannerClientStrings } from '../../lib/scanner/client-strings';
import type { ReportPageStrings } from '../../lib/scanner/report-page';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.scanner;
const report = text.report;
const clientStrings = await scannerClientStrings(lang);
const pageStrings: ReportPageStrings = {
	loading: report.loading,
	notFound: report.notFound,
	network: text.errors.network,
	scanned: report.scanned('{date}'),
	expires: report.expires('{date}'),
	copyLink: report.copyLink,
	copied: report.linkCopied,
	copiedStatus: report.linkCopiedStatus,
	copyError: report.copyLinkError
};
---

<Layout {lang} key="scannerReport" title={strings.meta.titleTemplate(report.title)} description={text.lead} noindex analytics={false}>
	<div
		data-report-page
		data-api={SCANNER_API}
		data-report-base={path(lang, 'scannerReport')}
		data-strings={JSON.stringify(clientStrings)}
		data-page={JSON.stringify(pageStrings)}
	>
		<Container as="header" size="text">
			<div class="head">
				<h1>{report.title}</h1>
				<p class="meta" data-report-meta></p>
				<div class="actions" data-report-actions hidden>
					<button type="button" class="btn" data-report-copy>
						<span data-report-copy-label>{report.copyLink}</span>
					</button>
					<a class="btn" href={path(lang, 'scanner')} data-report-rescan>{report.rescan}</a>
					<span class="sr-only" data-report-live aria-live="polite"></span>
				</div>
				<p class="hint" data-report-rescan-hint hidden></p>
				<div class="fallback" data-report-fallback hidden>
					<p class="fallback-error" data-report-error></p>
					<input type="text" readonly aria-label={report.linkLabel} data-report-url />
				</div>
			</div>
		</Container>

		<Container size="text">
			<p class="status" data-report-status role="status"></p>
			<noscript><p class="status">{report.noScript}</p></noscript>
			<ScannerResult {lang} />
			<p class="back"><a href={path(lang, 'scanner')}>{report.back}</a></p>
		</Container>
	</div>
</Layout>

<style>
	.head {
		padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
		border-bottom: 1px solid var(--line);
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.meta {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.actions .btn {
		cursor: pointer;
	}

	.actions .btn[data-state='copied'] {
		border-color: var(--check-pass);
	}

	.hint {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 0.875rem;
	}

	.fallback {
		margin-top: 1rem;
	}

	.fallback-error {
		margin: 0 0 0.5rem;
		font-size: 0.875rem;
	}

	.fallback input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--paper-sunken);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.status {
		margin: 1.5rem 0 0;
		font-size: 0.9375rem;
	}

	.status:empty {
		display: none;
	}

	.back {
		margin: 0 0 4rem;
	}

	.back a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.18em;
	}
</style>

<script>
	import { mountReportPage } from '../../lib/scanner/report-page';

	const root = document.querySelector<HTMLElement>('[data-report-page]');
	if (root !== null) {
		mountReportPage(root);
	}
</script>
