---
import Layout from '../../layouts/Layout.astro';
import Container from '../Container.astro';
import ScannerResult from '../scanner/ScannerResult.astro';
import { path, t, type Lang } from '../../lib/i18n';
import { SCANNER_API, scannerClientStrings } from '../../lib/scanner/client-strings';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.scanner;

const TURNSTILE_TEST_SITEKEY = '1x00000000000000000000AA';
const siteKey: string | undefined =
	import.meta.env.PUBLIC_TURNSTILE_SITEKEY || (process.env.VERCEL ? undefined : TURNSTILE_TEST_SITEKEY);
if (siteKey === undefined) {
	throw new Error('PUBLIC_TURNSTILE_SITEKEY must be set for Vercel builds');
}

const clientStrings = await scannerClientStrings(lang);
---

<Layout {lang} key="scanner" title={strings.meta.titleTemplate(text.title)} description={text.lead} noindex>
	<Container as="header" size="text">
		<div class="head">
			<h1>{text.title}</h1>
			<p>{text.lead}</p>
			<p class="about"><a href={path(lang, 'scannerAbout')}>{text.about.title}</a></p>
		</div>
	</Container>

	<Container size="text">
		<form
			class="scan"
			data-scanner-form
			data-api={SCANNER_API}
			data-sitekey={siteKey}
			data-strings={JSON.stringify(clientStrings)}
			novalidate
		>
			<label class="label" for="scan-url">{text.label}</label>
			<div class="row">
				<div class="field">
					<span class="affix" aria-hidden="true">https://</span>
					<input
						id="scan-url"
						name="url"
						type="text"
						inputmode="url"
						autocomplete="url"
						autocapitalize="off"
						spellcheck="false"
						required
						placeholder={text.placeholder}
					/>
					<span class="affix" aria-hidden="true">/</span>
				</div>
				<button class="btn primary" type="submit">{text.submit}</button>
			</div>
			<div class="bot-check" data-scanner-turnstile></div>
			<div class="progress" data-scanner-progress hidden><span></span></div>
			<p class="status" data-scanner-status role="status"></p>
		</form>
		<noscript><p class="help">{text.noScript}</p></noscript>
		<ScannerResult {lang} />
	</Container>
</Layout>

<style>
	.head {
		padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.head p {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.head .about {
		margin-top: 0.4rem;
		font-size: 0.9375rem;
	}

	.about a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.18em;
	}

	.about a:hover {
		text-decoration-color: currentColor;
	}

	.bot-check:has(:global(iframe)) {
		margin-top: 0.75rem;
	}

	.scan {
		position: relative;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--line);
	}

	.label {
		display: block;
		margin-bottom: 0.4rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink-muted);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.field {
		display: flex;
		align-items: center;
		flex: 1 1 18rem;
		min-width: 0;
		min-height: 48px;
		padding-inline: 0.85rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		transition: border-color 120ms ease;
	}

	.field:hover {
		border-color: var(--ink-faint);
	}

	.field:focus-within {
		border-color: var(--focus);
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.affix {
		color: var(--ink-faint);
		user-select: none;
	}

	input {
		flex: 1;
		min-width: 0;
		height: 46px;
		padding: 0 0.15rem;
		border: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
	}

	input:focus,
	input:focus-visible {
		outline: none;
	}

	input::placeholder {
		color: var(--ink-faint);
	}

	.row .btn {
		min-height: 48px;
	}

	button:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.progress {
		position: relative;
		height: 2px;
		margin-top: 0.75rem;
		overflow: hidden;
		background: var(--line);
	}

	.progress span {
		position: absolute;
		inset-block: 0;
		width: 35%;
		background: var(--focus);
		animation: sweep 1.1s ease-in-out infinite;
	}

	@keyframes sweep {
		from {
			left: -35%;
		}
		to {
			left: 100%;
		}
	}

	.help {
		margin: 0.6rem 0 0;
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.status {
		margin: 0.75rem 0 0;
		min-height: 1.5em;
		font-size: 0.9375rem;
	}

</style>

<script>
	import { mountScannerForm } from '../../lib/scanner/form';

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-scanner-form]')) {
		mountScannerForm(form);
	}
</script>
