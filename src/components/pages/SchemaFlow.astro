<script>
	import { mountSchemaFlow } from '../../lib/schemaflow/app';

	const header = document.querySelector<HTMLElement>('.header');
	const syncHeader = () => {
		if (header) document.documentElement.style.setProperty('--sf-header', `${header.offsetHeight}px`);
	};
	syncHeader();
	window.addEventListener('resize', syncHeader);

	for (const root of document.querySelectorAll<HTMLElement>('[data-schemaflow]')) {
		mountSchemaFlow(root);
	}
