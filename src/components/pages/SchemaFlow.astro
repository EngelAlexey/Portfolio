	.sf-thumb-card {
		fill: var(--surface);
		stroke: var(--line-strong);
	}

	.sf-thumb-head {
		fill: var(--paper-sunken);
		stroke: var(--line-strong);
	}

	.sf-thumb-row,
	.sf-thumb-key {
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	.sf-thumb-row {
		stroke: var(--ink-faint);
	}

	.sf-thumb-key {
		stroke: var(--focus);
	}

	.sf-glyph-line,
	.sf-glyph-end {
		fill: none;
		stroke: var(--ink-muted);
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	.sf-card.is-drop-target {
		border-color: var(--focus);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--focus) 25%, transparent), var(--shadow-card);
	}

	.sf-card.is-link-source {
		border-color: var(--focus);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--focus) 40%, transparent), var(--shadow-card);
	}

	.sf-canvas.is-linking,
	.sf-canvas.is-linking .sf-card,
	.sf-canvas.is-linking .sf-card-head {
		cursor: crosshair;
	}

	.sf-pill.is-hint {
		border-color: var(--focus);
		background: color-mix(in oklab, var(--focus) 10%, var(--surface));
		font-family: inherit;
		font-weight: 600;
		color: var(--ink);
	}

	.sf-ghost-chip {
		padding: 0.35rem 0.7rem;
		border-style: solid;
		border-radius: 999px;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink);
		white-space: nowrap;
	}

	.sf-ghost-chip.is-invalid {
		border-color: var(--line-strong);
		color: var(--ink-muted);
	}

	.sf-marquee {
		position: absolute;
		z-index: 10;
		border: 1px solid var(--focus);
		background: color-mix(in oklab, var(--focus) 8%, transparent);
		pointer-events: none;
	}

	.sf-ghost {
		position: fixed;
		z-index: 60;
		box-sizing: border-box;
		border: 1.5px dashed var(--focus);
		border-radius: var(--radius-sm);
		background: color-mix(in oklab, var(--surface) 85%, transparent);
		box-shadow: 0 12px 28px oklch(18% 0.008 260 / 0.16);
		pointer-events: none;
	}

	.sf-ghost[hidden] {
		display: none;
	}

	.sf-ghost-head {
		padding: 0.6rem 0.75rem;
		border-bottom: 1px dashed var(--line-strong);
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.sf-ghost-row {
		padding: 0.45rem 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
		white-space: pre;
	}

	.sf-connect-tag {
		position: fixed;
		z-index: 70;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		max-width: 22rem;
		padding: 6px 10px;
		border-radius: var(--radius-sm);
		background: var(--action);
		color: var(--action-ink);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		box-shadow: var(--shadow-card);
		pointer-events: none;
	}

	.sf-connect-tag[hidden] {
		display: none;
	}

	.sf-connect-tag.is-warning {
		border: 1px solid var(--sev-high);
		background: var(--surface);
		color: var(--ink);
	}

	.sf-connect-warn {
		font-family: var(--font-sans);
		color: var(--ink-muted);
	}

	.sf-empty {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 1.5rem 1.5rem 1.5rem calc(1.5rem + var(--sf-left-inset, 0px));
		pointer-events: none;
	}

	.sf-empty[hidden] {
		display: none;
	}

	.sf-empty-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 34rem;
		text-align: center;
		pointer-events: auto;
	}

	.sf-empty-icon {
		color: var(--ink-faint);
	}

	.sf-empty-title {
		margin: 0.75rem 0 0.4rem;
		font-size: 1.125rem;
		font-weight: 600;
	}

	.sf-empty-body {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.sf-empty-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.sf-empty-actions .sf-btn {
		min-height: 36px;
	}

	.sf-empty-privacy {
		margin: 1rem 0 0;
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.sf-banners {
		position: absolute;
		top: 12px;
		left: calc(12px + var(--sf-left-inset, 0px));
		right: 12px;
		z-index: 20;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		pointer-events: none;
	}

	.sf-banner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		max-width: 52rem;
		margin: 0 auto;
		padding: 0.5rem 0.5rem 0.5rem 0.85rem;
		border: 1px solid var(--line-strong);
		border-left: 3px solid var(--focus);
		border-radius: var(--radius-sm);
		background: var(--surface);
		box-shadow: var(--shadow-card);
		font-size: 0.8125rem;
		line-height: 1.45;
		pointer-events: auto;
	}

	.sf-banner-warning {
		border-left-color: var(--sev-high);
	}

	.sf-banner-error {
		border-left-color: var(--sev-critical);
	}

	.sf-banner-text {
		flex: 1 1 18rem;
	}

	.sf-banner-actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.sf-pill-wrap {
		position: absolute;
		left: 12px;
		bottom: 12px;
		z-index: 20;
		max-width: calc(100% - 15rem);
		pointer-events: none;
	}

	.sf-pill {
		margin: 0;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: color-mix(in oklab, var(--surface) 92%, transparent);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--ink-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sf-is-empty .sf-pill-wrap {
		display: none;
	}

	.sf-zoom {
		position: absolute;
		right: 12px;
		bottom: 12px;
		z-index: 20;
		display: flex;
		align-items: center;
		padding: 2px;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		box-shadow: var(--shadow-card);
	}

	.sf-zoom-value {
		min-width: 3.5rem;
		height: 32px;
		border: 0;
		border-radius: var(--radius-sm);
		background: none;
		color: var(--ink-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		cursor: pointer;
	}

	.sf-zoom-value:hover {
		background: var(--paper-sunken);
	}

	.sf-toast {
		position: absolute;
		right: 0;
		left: 0;
		bottom: 64px;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		box-sizing: border-box;
		width: max-content;
		max-width: min(28rem, calc(100% - 2rem));
		margin-inline: auto;
		padding: 10px 14px;
		border-radius: var(--radius-sm);
		background: var(--action);
		color: var(--action-ink);
		font-size: 0.8125rem;
		line-height: 1.4;
		box-shadow: var(--sf-overlay-shadow);
	}

	.sf-toast > span {
		flex: 1;
		min-width: 0;
	}

	.sf-toast[hidden] {
		display: none;
	}

	.sf-toast[data-kind='error'] {
		background: var(--sev-critical);
	}

	.sf-toast-action {
		flex: none;
		padding: 0.15rem 0.35rem;
		border: 0;
		border-radius: 4px;
		background: none;
		color: inherit;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.sf-toast-action:hover {
		text-decoration: underline;
	}

	.sf-sheet {
		position: absolute;
		top: 12px;
		right: 12px;
		bottom: 12px;
		z-index: 30;
		display: flex;
		flex-direction: column;
		width: min(360px, calc(100% - 24px));
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: var(--sf-overlay-shadow);
	}

	.sf-sheet[hidden] {
		display: none;
	}

	.sf-sheet-head {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0 0.35rem 0 0.25rem;
		border-bottom: 1px solid var(--line);
	}

	.sf-sheet-tabs {
		display: flex;
		flex: 1;
	}

	.sf-sheet-tab {
		min-height: 42px;
		padding: 0 0.75rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
	}

	.sf-sheet-tab[aria-selected='true'] {
		border-bottom-color: var(--ink);
		color: var(--ink);
		font-weight: 600;
	}

	.sf-sheet-tab:focus-visible {
		outline-offset: -2px;
	}

	.sf-sheet-body {
		flex: 1;
		min-height: 0;
		padding: 0.9rem;
		overflow-y: auto;
	}

	.sf-review-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.sf-review-score {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 1rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.sf-review-summary {
		margin: 0.35rem 0 0.75rem;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}

	.sf-review-group {
		margin: 0.9rem 0 0.4rem;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.sf-review-list {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sf-review-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.55rem 0.6rem;
		border: 1px solid var(--line);
		border-left: 3px solid var(--sev-low);
		border-radius: var(--radius-sm);
	}

	.sf-level-error {
		border-left-color: var(--sev-critical);
	}

	.sf-level-warning {
		border-left-color: var(--sev-high);
	}

	.sf-review-main {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
	}

	.sf-review-meta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.sf-review-level {
		font-size: 0.6875rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.sf-level-error .sf-review-level {
		color: var(--sev-critical);
	}

	.sf-level-warning .sf-review-level {
		color: var(--sev-high);
	}

	.sf-review-title {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.sf-review-body {
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.sf-review-item .sf-btn {
		align-self: flex-start;
	}

	.sf-tag {
		display: inline-block;
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		font-size: 0.6875rem;
		color: var(--ink-muted);
	}

	.sf-empty-note {
		margin: 0.5rem 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.sf-props {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.sf-props-title {
		margin: 0.6rem 0 0;
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.sf-props-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.sf-props-delete {
		align-self: flex-start;
		margin-top: 0.6rem;
	}

	.sf-field {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.sf-label {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--ink-faint);
	}

	.sf-input,
	.sf-select {
		box-sizing: border-box;
		width: 100%;
		min-width: 0;
		min-height: 32px;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 0.8125rem;
	}

	textarea.sf-input {
		resize: vertical;
	}

	.sf-mono {
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.sf-help {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.sf-conflict {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
		margin: 0;
		padding: 0.5rem 0.6rem;
		border-left: 3px solid var(--sev-critical);
		border-radius: 4px;
		background: color-mix(in oklab, var(--sev-critical) 9%, var(--surface));
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.sf-check,
	.sf-flag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8125rem;
		cursor: pointer;
	}

	.sf-check input,
	.sf-flag input {
		width: 15px;
		height: 15px;
		margin: 0;
		accent-color: var(--focus);
	}

	.sf-col-list,
	.sf-rel-list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sf-col-edit {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.45rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--paper);
	}

	.sf-col-line {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}

	.sf-col-line .sf-type-input {
		flex: 0 0 42%;
	}

	.sf-col-line .sf-icon-btn[aria-expanded='true'] .sf-icon {
		transform: rotate(180deg);
	}

	.sf-col-flags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.8rem;
	}

	.sf-col-details {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding-top: 0.35rem;
		border-top: 1px solid var(--line);
	}

	.sf-type-fields {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
		gap: 0.45rem;
	}

	.sf-rel-btn {
		width: 100%;
		padding: 0.4rem 0.55rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		text-align: left;
		cursor: pointer;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sf-rel-btn:hover {
		border-color: var(--line-strong);
		background: var(--paper-sunken);
	}

	.sf-index-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8125rem;
	}

	.sf-index-row > .sf-mono {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sf-index-draft {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		margin: 0;
		padding: 0.5rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
	}

	.sf-summary {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.3rem 0.8rem;
		margin: 0;
		font-size: 0.8125rem;
	}

	.sf-summary dt {
		color: var(--ink-faint);
	}

	.sf-summary dd {
		margin: 0;
	}

	.sf-swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.sf-swatch-btn,
	.sf-swatch {
		display: inline-block;
		box-sizing: border-box;
		width: 20px;
		height: 20px;
		padding: 0;
		border: 1px solid var(--sf-c-line, var(--line-strong));
		border-radius: 50%;
		background: var(--sf-c-bg, var(--surface));
		cursor: pointer;
	}

	.sf-swatch {
		width: 14px;
		height: 14px;
	}

	.sf-swatch-btn[aria-checked='true'] {
		box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px var(--focus);
	}

	.sf-swatch-btn.sf-swatch-none,
	.sf-swatch.sf-swatch-none {
		background: linear-gradient(135deg, transparent 45%, var(--sev-critical) 45%, var(--sev-critical) 55%, transparent 55%), var(--surface);
	}

	.sf-swatch-fullstack {
		--sf-c-bg: var(--area-fullstack-bg);
		--sf-c-line: var(--area-fullstack-line);
	}

	.sf-swatch-ia {
		--sf-c-bg: var(--area-ia-bg);
		--sf-c-line: var(--area-ia-line);
	}

	.sf-swatch-datos {
		--sf-c-bg: var(--area-datos-bg);
		--sf-c-line: var(--area-datos-line);
	}

	.sf-swatch-movil {
		--sf-c-bg: var(--area-movil-bg);
		--sf-c-line: var(--area-movil-line);
	}

	.sf-swatch-seguridad {
		--sf-c-bg: var(--area-seguridad-bg);
		--sf-c-line: var(--area-seguridad-line);
	}

	.sf-swatch-infra {
		--sf-c-bg: var(--area-infra-bg);
		--sf-c-line: var(--area-infra-line);
	}

	.sf-swatch-neutral {
		--sf-c-bg: var(--paper-sunken);
		--sf-c-line: var(--line-strong);
	}

	.sf-sep {
		height: 1px;
		margin: 0.3rem 0;
		border: 0;
		background: var(--line);
	}

	.sf-overlay {
		position: fixed;
		inset: 0;
		z-index: 80;
		pointer-events: none;
	}

	.sf-overlay > * {
		pointer-events: auto;
	}

	.sf-bubble {
		position: fixed;
		box-sizing: border-box;
		width: min(21rem, calc(100vw - 1.5rem));
		max-height: calc(100dvh - 2rem);
		overflow-y: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--ink);
		box-shadow: var(--sf-overlay-shadow);
	}

	.sf-bubble-glossary {
		width: min(18rem, calc(100vw - 1.5rem));
	}

	.sf-bubble-relate {
		width: min(22rem, calc(100vw - 1.5rem));
	}

	.sf-bubble-body {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 0.8rem 0.9rem 0.9rem;
	}

	.sf-bubble > .sf-bubble-text {
		margin: 0;
		padding: 0.8rem 0.9rem;
	}

	.sf-bubble-close {
		position: absolute;
		top: 0.4rem;
		right: 0.4rem;
		width: 28px;
		height: 28px;
	}

	.sf-bubble-title {
		margin: 0;
		padding-right: 1.75rem;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.sf-bubble-text {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.sf-bubble-note {
		margin: 0;
		font-size: 0.78rem;
		color: var(--sev-critical);
	}

	.sf-bubble-actions {
