	.sf-palette-grid-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.sf-palette-item {
		display: flex;
		box-sizing: border-box;
		min-width: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
