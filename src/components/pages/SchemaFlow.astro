	.sf-palette.is-collapsed .sf-palette-toggle {
		border-bottom: 0;
	}

	.sf-palette-title {
		flex: 1;
		white-space: nowrap;
	}

	.sf-palette-toggle .sf-icon-chevron {
		color: var(--ink-faint);
		transform: rotate(180deg);
		transition: transform 120ms ease;
	}

	.sf-palette.is-collapsed .sf-icon-chevron {
		transform: none;
	}

	.sf-palette-body {
		padding: 0.55rem 0.6rem 0.7rem;
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.sf-palette-body[hidden] {
		display: none;
	}

	.sf-palette-hint {
		margin: 0 0 0.6rem;
		font-size: 0.75rem;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.sf-palette-group + .sf-palette-group {
		margin-top: 0.75rem;
	}

	.sf-palette-group-title {
		margin: 0 0 0.35rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--ink-faint);
