---
import Layout from '../../layouts/Layout.astro';
import { t, type Lang } from '../../lib/i18n';
import { SCANNER_API } from '../../lib/scanner/client-strings';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.schemaflow;

const plural = (one: string, many: string): [string, string] => [one, many.replace('2', '{n}')];
const [tablesOne, relationsOne] = text.counts(1, 1).split(' · ');
const [tablesMany, relationsMany] = text.counts(2, 2).split(' · ');

const clientStrings = {
	tables: plural(tablesOne ?? '', tablesMany ?? ''),
	relations: plural(relationsOne ?? '', relationsMany ?? ''),
	columns: plural(text.columns(1), text.columns(2)),
	score: text.score(0).replace('0', '{n}'),
	rendering: text.rendering,
	reviewEmpty: text.reviewEmpty,
	severity: text.severity,
	presets: text.presets,
	glossary: text.glossary,
	rules: text.rules,
	recommendation: text.recommendation,
	fixSql: text.fixSql,
	copied: text.copied,
	sqlCopied: text.sqlCopied,
	copyError: text.copyError,
	errors: text.errors,
	tableName: text.tableName,
	columnName: text.columnName,
	columnType: text.columnType,
	deleteColumn: text.deleteColumn,
	notNull: text.notNull,
	reference: text.reference,
	noReference: text.noReference,
	onDelete: text.onDelete,
	newTable: text.newTable,
	newColumn: text.newColumn
};

const TYPES = ['UUID', 'INT', 'BIGINT', 'SERIAL', 'BIGSERIAL', 'TEXT', 'VARCHAR(255)', 'BOOLEAN', 'NUMERIC(10, 2)', 'DATE', 'TIMESTAMPTZ', 'JSONB'];

const icon = {
	plus: 'M12 5v14M5 12h14',
	trash: 'M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3',
	copy: 'M9 9h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V9ZM5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1',
	download: 'M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2',
	apply: 'M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5',
	close: 'M6 6l12 12M18 6 6 18',
	minus: 'M5 12h14',
	fit: 'M4 9V5a1 1 0 0 1 1-1h4M15 4h4a1 1 0 0 1 1 1v4M20 15v4a1 1 0 0 1-1 1h-4M9 20H5a1 1 0 0 1-1-1v-4',
	design: 'M3 3h7v7H3zM14 14h7v7h-7zM10 6.5h3.5a2 2 0 0 1 2 2V14',
	code: 'm8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14',
	erase: 'M20 20H9L4 15a2 2 0 0 1 0-2.8L13.2 3a2 2 0 0 1 2.8 0L21 8a2 2 0 0 1 0 2.8L12 20'
};
---

<Layout {lang} key="schemaflow" title={strings.meta.titleTemplate(text.title)} description={text.lead}>
	<div class="app" data-schemaflow data-api={SCANNER_API} data-strings={JSON.stringify(clientStrings)}>
		<div class="toolbar">
			<div class="brand">
				<h1>{text.heading}</h1>
				<p class="sr-only">{text.lead}</p>
			</div>

			<div class="templates" role="group" aria-label={text.templates}>
				<span class="toolbar-label">{text.templates}</span>
				<div class="chips" data-sf-presets></div>
			</div>

			<div class="actions">
				<button type="button" class="tbtn strong" data-sf-add-table>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.plus} /></svg>
					<span>{text.addTable}</span>
				</button>
				<button type="button" class="tbtn score" data-sf-score disabled>
					<span class="dot" aria-hidden="true"></span>
					<span data-sf-score-text>{text.score(100).replace('100/', '–/')}</span>
				</button>
				<button type="button" class="tbtn" data-sf-mermaid disabled>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.copy} /></svg>
					<span>{text.copyMermaid}</span>
				</button>
				<button type="button" class="tbtn" data-sf-svg disabled>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.download} /></svg>
					<span>{text.downloadSvg}</span>
				</button>
				<button type="button" class="tbtn ghost" data-sf-clear-canvas>
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.erase} /></svg>
					<span>{text.clearCanvas}</span>
				</button>
			</div>
		</div>

		<div class="workspace">
			<aside class="panel">
				<div class="tabs" role="tablist" aria-label={text.heading}>
					<button type="button" role="tab" id="sf-tab-design" aria-selected="true" aria-controls="sf-panel-design" data-sf-tab="design">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.design} /></svg>
						{text.modeDesign}
					</button>
					<button type="button" role="tab" id="sf-tab-sql" aria-selected="false" aria-controls="sf-panel-sql" tabindex="-1" data-sf-tab="sql">
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.code} /></svg>
						{text.modeSql}
					</button>
				</div>

				<section class="tabpanel design" id="sf-panel-design" role="tabpanel" aria-labelledby="sf-tab-design" data-sf-panel="design">
					<p class="hint" data-sf-select-hint>{text.selectHint}</p>
					<div class="table-editor" data-sf-editor hidden>
						<div class="field-row">
							<label class="field-label" for="sf-table-name">{text.tableName}</label>
							<div class="name-row">
								<input id="sf-table-name" class="input mono" type="text" spellcheck="false" autocomplete="off" data-sf-table-name />
								<button type="button" class="icon-btn danger" aria-label={text.deleteTable} title={text.deleteTable} data-sf-delete-table>
									<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.trash} /></svg>
								</button>
							</div>
						</div>
						<h2 class="field-label">{text.columnsTitle}</h2>
						<ol class="col-list" data-sf-columns></ol>
						<button type="button" class="tbtn add-col" data-sf-add-column>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.plus} /></svg>
							{text.addColumn}
						</button>
					</div>
				</section>

				<form class="tabpanel sql" id="sf-panel-sql" role="tabpanel" aria-labelledby="sf-tab-sql" data-sf-panel="sql" data-sf-form hidden>
					<div class="editor-top">
						<label for="sf-sql">{text.editorLabel}</label>
						<div class="editor-actions">
							<button type="button" class="link-btn" data-sf-copy-sql>{text.copySql}</button>
							<button type="button" class="link-btn" data-sf-clear>{text.clear}</button>
						</div>
					</div>
					<textarea id="sf-sql" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder={text.placeholder} data-sf-sql></textarea>
					<div class="editor-bottom">
						<p class="hint">{text.sqlHint}</p>
						<button type="submit" class="btn primary render" data-sf-render>
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.apply} /></svg>
							{text.render}
						</button>
					</div>
				</form>

				<p class="status" role="status" data-sf-status></p>
			</aside>

			<section class="canvas" aria-label={text.canvasLabel} data-sf-viewport>
				<div class="world" data-sf-world>
					<svg class="edges" data-sf-edges aria-hidden="true">
						<defs>
							<marker id="sf-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
								<path class="arrow" d="M 0 1 L 10 5 L 0 9 z"></path>
							</marker>
						</defs>
						<g data-sf-paths></g>
					</svg>
					<div class="cards" data-sf-cards></div>
				</div>

				<p class="empty" data-sf-empty>{text.empty}</p>

				<div class="zoom">
					<button type="button" aria-label={text.zoomIn} title={text.zoomIn} data-sf-zoom="in">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={icon.plus} /></svg>
					</button>
					<button type="button" aria-label={text.zoomOut} title={text.zoomOut} data-sf-zoom="out">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={icon.minus} /></svg>
					</button>
					<button type="button" aria-label={text.zoomReset} title={text.zoomReset} data-sf-zoom="fit">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.fit} /></svg>
					</button>
				</div>

			<aside class="sheet" role="dialog" aria-labelledby="sf-review-title" data-sf-review hidden>
				<div class="sheet-head">
					<h2 id="sf-review-title">{text.reviewTitle}</h2>
					<button type="button" class="icon-btn" aria-label={text.close} data-sf-close>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={icon.close} /></svg>
					</button>
				</div>
				<div class="sheet-body" data-sf-review-body></div>
			</aside>

				<p class="info">
					<span data-sf-counts></span>
					<span class="hint-inline">{text.guideHint}</span>
				</p>
			</section>
		</div>

		<datalist id="sf-types">
			{TYPES.map((type) => <option value={type} />)}
		</datalist>


		<div class="bubble" role="dialog" aria-labelledby="sf-term-title" data-sf-term hidden>
			<div class="sheet-head">
				<span class="badge" data-sf-term-badge></span>
				<h2 id="sf-term-title" data-sf-term-title></h2>
				<button type="button" class="icon-btn" aria-label={text.close} data-sf-close>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={icon.close} /></svg>
				</button>
			</div>
			<div class="term-body">
				<h3>{text.basic}</h3>
				<p data-sf-term-basic></p>
				<h3>{text.advanced}</h3>
				<p class="advanced" data-sf-term-advanced></p>
			</div>
		</div>
	</div>
	<noscript><p class="help">{text.empty}</p></noscript>
</Layout>

<style>
	.app {
		display: flex;
		flex-direction: column;
		height: calc(100dvh - var(--sf-header, 4.05rem));
		min-height: 34rem;
		background: var(--surface);
	}

	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.25rem;
		padding: 0.55rem clamp(0.75rem, 2vw, 1.25rem);
		border-bottom: 1px solid var(--line);
	}

	.brand h1 {
		margin: 0;
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.templates {
		display: flex;
		flex: 1 1 auto;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}

	.toolbar-label {
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.chips :global(button) {
		padding: 0.28rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
		transition: border-color 120ms ease, color 120ms ease;
	}

	.chips :global(button:hover) {
		border-color: var(--line-strong);
		color: var(--ink);
	}

	.chips :global(button[aria-pressed='true']) {
		border-color: var(--action);
		background: var(--action);
		color: var(--action-ink);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.tbtn {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2rem;
		padding: 0 0.7rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
		transition: border-color 120ms ease, background 120ms ease;
	}

	.tbtn:hover:not(:disabled) {
		border-color: var(--line-strong);
		background: var(--paper-sunken);
	}

	.tbtn:disabled {
		opacity: 0.55;
		cursor: default;
	}

	.tbtn.strong {
		border-color: var(--action);
		background: var(--action);
		color: var(--action-ink);
	}

	.tbtn.strong:hover:not(:disabled) {
		border-color: var(--action-hover);
		background: var(--action-hover);
	}

	.tbtn.ghost {
		border-color: transparent;
		color: var(--ink-muted);
	}

	.score {
		font-family: var(--font-mono);
		font-variant-numeric: tabular-nums;
	}

	.score .dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--score, var(--ink-faint));
	}

	button:focus-visible,
	textarea:focus-visible,
	input:focus-visible,
	select:focus-visible,
	.cards :global(.sf-card:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.workspace {
		position: relative;
		display: grid;
		grid-template-columns: minmax(17rem, 23rem) 1fr;
		flex: 1;
		min-height: 0;
	}

	.panel {
		display: flex;
		flex-direction: column;
		min-height: 0;
		border-right: 1px solid var(--line);
		background: var(--surface);
	}

	.tabs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-bottom: 1px solid var(--line);
	}

	.tabs button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		padding: 0.65rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.875rem;
		cursor: pointer;
	}

	.tabs button[aria-selected='true'] {
		border-bottom-color: var(--ink);
		color: var(--ink);
		font-weight: 600;
	}

	.tabs button:focus-visible {
		outline-offset: -2px;
	}

	.tabpanel {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
	}

	.tabpanel[hidden] {
		display: none;
	}

	.design {
		overflow-y: auto;
		padding: 0.9rem;
	}

	.hint {
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.5;
		color: var(--ink-muted);
	}

	.table-editor {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.table-editor[hidden] {
		display: none;
	}

	.field-row {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin-bottom: 0.5rem;
	}

	.field-label {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.name-row {
		display: flex;
		gap: 0.4rem;
	}

	.input,
	.panel :global(.sf-input),
	.panel :global(.sf-select) {
		width: 100%;
		min-width: 0;
		height: 2.1rem;
		padding: 0 0.55rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 0.8125rem;
	}

	.mono,
	.panel :global(.sf-input) {
		font-family: var(--font-mono);
	}

	.icon-btn {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.1rem;
		height: 2.1rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
	}

	.icon-btn:hover,
	.panel :global(.sf-icon-btn:hover) {
		background: var(--paper-sunken);
		color: var(--ink);
	}

	.icon-btn.danger:hover,
	.panel :global(.sf-icon-btn:hover) {
		color: var(--sev-critical);
	}

	.col-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.col-list :global(.sf-col-edit) {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.55rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--paper);
	}

	.col-list :global(.sf-col-line) {
		display: flex;
		gap: 0.35rem;
		align-items: center;
	}

	.col-list :global(.sf-col-line .sf-type-input) {
		flex: 0 0 42%;
	}

	.panel :global(.sf-icon-btn) {
		display: grid;
		flex: none;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 0;
		border-radius: var(--radius-sm);
		background: none;
		color: var(--ink-faint);
		cursor: pointer;
	}

	.col-list :global(.sf-flags) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.col-list :global(.sf-flag) {
		position: relative;
		display: inline-flex;
		align-items: center;
		cursor: pointer;
	}

	.col-list :global(.sf-flag input) {
		position: absolute;
		opacity: 0;
		inset: 0;
		margin: 0;
		cursor: pointer;
	}

	.col-list :global(.sf-flag span) {
		padding: 0.12rem 0.45rem;
		border: 1px solid var(--line-strong);
		border-radius: 4px;
		background: var(--surface);
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
	}

	.col-list :global(.sf-flag input:checked + span) {
		border-color: var(--ink);
		background: var(--ink);
		color: var(--ink-inverted);
	}

	.col-list :global(.sf-flag input:focus-visible + span) {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.col-list :global(.sf-ref) {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.35rem;
	}

	.col-list :global(.sf-ref .sf-select:only-child) {
		grid-column: 1 / -1;
	}

	.add-col {
		justify-content: center;
		border-style: dashed;
	}

	.sql {
		min-height: 0;
	}

	.editor-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.5rem 0.85rem;
		border-bottom: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--ink-faint);
	}

	.editor-actions {
		display: flex;
		gap: 0.25rem;
	}

	.link-btn {
		padding: 0.15rem 0.35rem;
		border: 0;
		border-radius: 4px;
		background: none;
		color: var(--ink-muted);
		font: inherit;
		cursor: pointer;
	}

	.link-btn:hover {
		color: var(--ink);
	}

	textarea {
		flex: 1;
		min-height: 0;
		width: 100%;
		padding: 0.85rem;
		border: 0;
		background: var(--paper-sunken);
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.6;
		tab-size: 2;
		resize: none;
	}

	textarea:focus-visible {
		outline-offset: -2px;
	}

	.editor-bottom {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 0.75rem 0.85rem;
		border-top: 1px solid var(--line);
	}

	.render {
		justify-content: center;
		gap: 0.45rem;
		width: 100%;
		min-height: 2.5rem;
		cursor: pointer;
	}

	.render:disabled {
		opacity: 0.6;
		cursor: progress;
	}

	.status {
		margin: 0;
		padding: 0 0.85rem;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--ink-muted);
	}

