	.sf-palette-label {
		max-width: 100%;
		overflow: hidden;
		font-size: 0.75rem;
		line-height: 1.25;
		color: var(--ink);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sf-palette-tile .sf-palette-label {
		overflow: visible;
		text-align: center;
		white-space: normal;
	}

	.sf-palette-type {
		max-width: 100%;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		line-height: 1.3;
		color: var(--ink-faint);
		text-overflow: ellipsis;
		white-space: nowrap;
