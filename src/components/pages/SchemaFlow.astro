---
import Layout from '../../layouts/Layout.astro';
import { t, type Lang } from '../../lib/i18n';
import { ICONS, type IconName } from '../../lib/schemaflow/ui/dom';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.schemaflow;

const svg = (name: IconName, size = 16) =>
	`<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="sf-icon"><path d="${ICONS[name]}"/></svg>`;
---

<Layout {lang} key="schemaflow" title={strings.meta.titleTemplate(text.title)} description={text.lead} app>
	<div class="sf" data-schemaflow data-lang={lang} data-strings={JSON.stringify(text)}>
		<header class="sf-bar">
			<div class="sf-bar-group" role="group" aria-label={text.bar.groupDocument}>
				<button type="button" class="sf-icon-btn sf-only-wide" data-action="toggle-dock" aria-pressed="true" aria-label={text.bar.codeToggle} data-tip={text.bar.codeToggle}><Fragment set:html={svg('dock')} /></button>
				<h1 class="sf-title">{text.heading}<span class="sr-only">: {text.title}</span></h1>
				<input class="sf-name" data-name aria-label={text.bar.designName} placeholder={text.bar.untitled} maxlength="128" spellcheck="false" autocomplete="off" />
				<span class="sf-save" data-save tabindex="0"></span>
			</div>
			<span class="sf-divider sf-only-wide" aria-hidden="true"></span>
			<div class="sf-bar-group" role="group" aria-label={text.bar.groupInsert}>
				<button type="button" class="sf-tool sf-tool-strong" data-tool="table" data-tip={text.bar.tableTip} aria-label={text.bar.table}><Fragment set:html={svg('plus', 15)} /><span class="sf-tool-label">{text.bar.table}</span></button>
			</div>
			<span class="sf-divider sf-only-wide" aria-hidden="true"></span>
			<div class="sf-bar-group" role="group" aria-label={text.bar.groupHistory}>
				<button type="button" class="sf-icon-btn" data-action="undo" aria-label={text.bar.undo} data-tip={text.bar.nothingToUndo} disabled><Fragment set:html={svg('undo')} /></button>
				<button type="button" class="sf-icon-btn" data-action="redo" aria-label={text.bar.redo} data-tip={text.bar.nothingToRedo} disabled><Fragment set:html={svg('redo')} /></button>
				<button type="button" class="sf-tool sf-only-wide" data-action="arrange" data-tip={text.bar.arrangeTip} aria-label={text.bar.arrange}><Fragment set:html={svg('arrange')} /><span class="sf-tool-label sf-label-xl">{text.bar.arrange}</span></button>
			</div>
			<span class="sf-spacer"></span>
			<div class="sf-bar-group" role="group" aria-label={text.bar.groupOutput}>
				<button type="button" class="sf-score sf-only-wide" data-action="review" data-tip={text.bar.scoreTip}><span class="sf-score-dot" data-score-dot aria-hidden="true"></span><span data-score-text>{text.bar.scoreEmpty}</span></button>
				<button type="button" class="sf-icon-btn sf-only-wide" data-action="properties" aria-pressed="false" aria-label={text.bar.properties} data-tip={text.bar.properties}><Fragment set:html={svg('properties')} /></button>
				<button type="button" class="sf-tool sf-only-wide" data-action="templates" aria-label={text.bar.templates}><Fragment set:html={svg('templates')} /><span class="sf-tool-label sf-label-md">{text.bar.templates}</span></button>
				<button type="button" class="sf-tool sf-only-wide" data-action="share" aria-label={text.bar.share}><Fragment set:html={svg('share')} /><span class="sf-tool-label sf-label-md">{text.bar.share}</span></button>
				<button type="button" class="sf-tool sf-only-wide" data-action="file" aria-haspopup="menu" aria-expanded="false"><span class="sf-tool-label">{text.bar.file}</span><Fragment set:html={svg('chevron', 14)} /></button>
				<button type="button" class="sf-icon-btn sf-only-narrow" data-action="more" aria-haspopup="menu" aria-label={text.bar.more} data-tip={text.bar.more}><Fragment set:html={svg('more')} /></button>
			</div>
		</header>

		<div class="sf-body">
			<aside class="sf-dock" data-dock aria-label={text.code.title}></aside>
			<div class="sf-resize" data-resize role="separator" aria-orientation="vertical" aria-label={text.code.resize} aria-valuemin="320" aria-valuemax="640" aria-valuenow="400" tabindex="0"></div>
			<section class="sf-canvas" data-canvas tabindex="-1" aria-label={text.canvas.label} aria-describedby="sf-canvas-help">
				<aside class="sf-palette" data-palette aria-label={text.palette.title}></aside>
				<div class="sf-world" data-world>
					<div class="sf-areas" data-areas></div>
					<svg class="sf-edges" data-edges width="1" height="1"></svg>
					<div class="sf-cards" data-cards></div>
					<div class="sf-notes" data-notes></div>
				</div>
				<div class="sf-empty" data-empty hidden>
					<div class="sf-empty-box">
						<span class="sf-empty-icon"><Fragment set:html={svg('diagram', 40)} /></span>
						<h2 class="sf-empty-title">{text.empty.title}</h2>
						<p class="sf-empty-body">{text.empty.body}</p>
						<div class="sf-empty-actions">
							<button type="button" class="sf-btn sf-btn-primary" data-action="empty-create"><Fragment set:html={svg('plus', 14)} />{text.empty.create}</button>
							<button type="button" class="sf-btn" data-action="empty-template"><Fragment set:html={svg('templates', 14)} />{text.empty.template}</button>
							<button type="button" class="sf-btn" data-action="empty-import"><Fragment set:html={svg('code', 14)} />{text.empty.import}</button>
							<button type="button" class="sf-btn" data-action="empty-open"><Fragment set:html={svg('file', 14)} />{text.empty.open}</button>
						</div>
						<p class="sf-empty-privacy">{text.empty.privacy}</p>
					</div>
				</div>
				<div class="sf-banners" data-banners></div>
				<div class="sf-pill-wrap"><p class="sf-pill" data-pill></p></div>
				<div class="sf-zoom" role="group" aria-label={text.canvas.label}>
					<button type="button" class="sf-icon-btn" data-action="zoom-out" aria-label={text.canvas.zoomOut} data-tip={text.canvas.zoomOut}><Fragment set:html={svg('minus')} /></button>
					<button type="button" class="sf-zoom-value" data-action="zoom-reset" data-zoom-value aria-label={text.canvas.zoomReset} data-tip={text.canvas.zoomReset}>{text.canvas.zoomValue.replace('{n}', '100')}</button>
					<button type="button" class="sf-icon-btn" data-action="zoom-in" aria-label={text.canvas.zoomIn} data-tip={text.canvas.zoomIn}><Fragment set:html={svg('plus')} /></button>
					<button type="button" class="sf-icon-btn" data-action="zoom-fit" aria-label={text.canvas.zoomFit} data-tip={text.canvas.zoomFit}><Fragment set:html={svg('fit')} /></button>
				</div>
				<aside class="sf-sheet" data-sheet hidden aria-label={text.props.sheet}></aside>
			</section>
		</div>

		<nav class="sf-mobilebar" aria-label={text.heading}>
			<button type="button" data-mobile="diagram" aria-pressed="true"><Fragment set:html={svg('diagram')} /><span>{text.canvas.short}</span></button>
			<button type="button" data-mobile="code" aria-pressed="false"><Fragment set:html={svg('code')} /><span>{text.code.title}</span></button>
			<button type="button" data-mobile="properties" aria-pressed="false"><Fragment set:html={svg('properties')} /><span>{text.props.tab}</span></button>
			<button type="button" data-mobile="review" aria-pressed="false"><Fragment set:html={svg('review')} /><span>{text.review.tab}</span><span class="sf-count-badge" data-review-count hidden></span></button>
		</nav>

		<p id="sf-canvas-help" class="sr-only">{text.canvas.help}</p>
		<p class="sr-only" role="status" aria-live="polite" data-live></p>
		<input type="file" data-file hidden accept=".json,.sql,.js,.txt,.ddl,application/json" />
	</div>
	<noscript><p class="sf-noscript">{text.lead}</p></noscript>
</Layout>

<style is:global>
	.sf {
		--sf-dock-width: 400px;
		--sf-row-hot: color-mix(in oklab, var(--focus) 8%, transparent);
		--sf-row-sel: color-mix(in oklab, var(--focus) 12%, transparent);
		--sf-drop: color-mix(in oklab, var(--focus) 16%, var(--surface));
		--sf-drop-warn: color-mix(in oklab, var(--sev-high) 18%, var(--surface));
		--sf-overlay-shadow: var(--shadow-card), 0 16px 40px oklch(18% 0.008 260 / 0.14);
		--sf-code-keyword: var(--area-fullstack-fg);
		--sf-code-type: var(--area-datos-fg);
		--sf-code-string: var(--area-infra-fg);
		--sf-code-number: var(--area-movil-fg);
		--sf-code-property: var(--area-ia-fg);
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		min-width: 0;
		background: var(--surface);
		color: var(--ink);
	}

	.sf-overlay,
	.sf-gallery,
	.sf-shortcuts {
		--sf-overlay-shadow: var(--shadow-card), 0 16px 40px oklch(18% 0.008 260 / 0.14);
	}

	.sf-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem 0.75rem;
		height: 52px;
		padding: 0 clamp(0.6rem, 1.4vw, 1rem);
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		overflow: hidden;
	}

	.sf-bar-group {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		min-width: 0;
	}

	.sf-divider {
		flex: none;
		width: 1px;
		height: 20px;
		background: var(--line);
	}

	.sf-spacer {
		flex: 1;
	}

	.sf-title {
		margin: 0 0.25rem 0 0.15rem;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.sf-name {
		width: clamp(7rem, 14vw, 15rem);
		min-width: 0;
		height: 32px;
		padding: 0 0.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 0.875rem;
		text-overflow: ellipsis;
	}

	.sf-name:hover {
		border-color: var(--line);
	}

	.sf-name:focus {
		border-color: var(--focus);
		outline: none;
		background: var(--surface);
	}

	.sf-save {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.8125rem;
		color: var(--ink-faint);
		white-space: nowrap;
	}

	.sf-save.is-failed {
		color: var(--sev-critical);
	}

	.sf-btn,
	.sf-tool,
	.sf-score {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		min-height: 32px;
		padding: 0 0.7rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		font-size: 0.8125rem;
		line-height: 1.2;
		white-space: nowrap;
		cursor: pointer;
		transition: border-color 120ms ease, background-color 120ms ease, color 120ms ease;
	}

	.sf-btn:hover:not(:disabled),
	.sf-tool:hover:not(:disabled),
	.sf-score:hover:not(:disabled) {
		border-color: var(--line-strong);
		background: var(--paper-sunken);
	}

	.sf-btn:disabled,
	.sf-tool:disabled,
	.sf-icon-btn:disabled {
		opacity: 0.45;
		cursor: default;
	}

	.sf-btn-primary,
	.sf-tool-strong {
		border-color: var(--action);
		background: var(--action);
		color: var(--action-ink);
	}

	.sf-btn-primary:hover:not(:disabled),
	.sf-tool-strong:hover:not(:disabled) {
		border-color: var(--action-hover);
		background: var(--action-hover);
	}

	.sf-tool-strong {
		cursor: grab;
	}

	.sf-btn-ghost {
		border-color: transparent;
		background: transparent;
		color: var(--ink-muted);
	}

	.sf-btn-danger {
		color: var(--sev-critical);
	}

	.sf-btn-danger-solid {
		border-color: var(--sev-critical);
		background: var(--sev-critical);
		color: var(--surface);
	}

	.sf-btn-small {
		min-height: 28px;
		padding: 0 0.55rem;
		font-size: 0.75rem;
	}

	.sf-btn-dashed {
		width: 100%;
		border-style: dashed;
		color: var(--ink-muted);
	}

	.sf-icon-btn {
		display: inline-grid;
		flex: none;
		place-items: center;
		width: 32px;
		height: 32px;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		background: transparent;
		color: var(--ink-muted);
		cursor: pointer;
	}

	.sf-icon-btn:hover:not(:disabled) {
		background: var(--paper-sunken);
		color: var(--ink);
	}

	.sf-icon-btn[aria-pressed='true'] {
		background: var(--paper-sunken);
		color: var(--ink);
		border-color: var(--line);
	}

	.sf-score {
		font-variant-numeric: tabular-nums;
	}

	.sf-score-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: var(--ink-faint);
	}

	.sf-score-dot[data-level='ok'] {
		background: var(--check-pass);
	}

	.sf-score-dot[data-level='medium'] {
		background: var(--sev-medium);
	}

	.sf-score-dot[data-level='high'] {
		background: var(--sev-high);
	}

	.sf-score-dot[data-level='critical'] {
		background: var(--sev-critical);
	}

	.sf :focus-visible,
	.sf-overlay :focus-visible,
	.sf-gallery :focus-visible,
	.sf-shortcuts :focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.sf-body {
		position: relative;
		display: flex;
		flex: 1;
		min-height: 0;
	}

	.sf-dock {
		display: flex;
		flex: none;
		flex-direction: column;
		width: var(--sf-dock-width);
		min-height: 0;
		border-right: 1px solid var(--line);
		background: var(--surface);
	}

	.sf-dock-closed .sf-dock,
	.sf-dock-closed .sf-resize {
		display: none;
	}

	.sf-resize {
		position: relative;
		z-index: 5;
		flex: none;
		width: 6px;
		margin-left: -3px;
		margin-right: -3px;
		cursor: col-resize;
	}

	.sf-resize:hover,
	.sf-resize:focus-visible {
		background: color-mix(in oklab, var(--focus) 40%, transparent);
	}

	.sf-dock-tabs {
		display: flex;
		border-bottom: 1px solid var(--line);
	}

	.sf-dock-tab {
		flex: 1;
		min-height: 40px;
		padding: 0 0.5rem;
		border: 0;
		border-bottom: 2px solid transparent;
		background: none;
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.8125rem;
		white-space: nowrap;
		cursor: pointer;
	}

	.sf-dock-tab[aria-selected='true'] {
		border-bottom-color: var(--ink);
		color: var(--ink);
		font-weight: 600;
	}

	.sf-dock-tab:focus-visible {
		outline-offset: -2px;
	}

	.sf-dock-select {
		display: none;
		margin: 0.5rem 0.75rem;
	}

	.sf-dock-status {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 36px;
		padding: 0 0.5rem 0 0.75rem;
		border-bottom: 1px solid var(--line);
	}

	.sf-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}

	.sf-chip-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--check-pass);
	}

	.sf-chip-edited .sf-chip-dot {
		background: var(--sev-medium);
	}

	.sf-chip-applying .sf-chip-dot {
		background: var(--focus);
		animation: sf-pulse 900ms ease-in-out infinite alternate;
	}

	@keyframes sf-pulse {
		from {
			opacity: 0.3;
		}
		to {
			opacity: 1;
		}
	}

	.sf-dock-note {
		margin: 0;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--line);
		background: var(--paper-sunken);
		font-size: 0.8125rem;
		color: var(--ink-muted);
	}

	.sf-dock-note[hidden] {
		display: none;
	}

	.sf-dock-import {
		background: color-mix(in oklab, var(--focus) 10%, var(--surface));
		color: var(--ink);
	}

	.sf-editor {
		position: relative;
		flex: 1;
		min-height: 0;
		overflow: hidden;
		background: var(--paper-sunken);
	}

	.sf-editor .cm-editor {
		height: 100%;
	}

	.sf-query {
		flex: none;
		border-top: 1px solid var(--line);
		font-size: 0.8125rem;
		white-space: normal;
	}

	.sf-query[hidden] {
		display: none;
	}

	.sf-query > summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.75rem;
		font-weight: 600;
		cursor: pointer;
	}

	.sf-query-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		max-height: min(22rem, 50dvh);
		padding: 0 0.75rem 0.75rem;
		overflow-y: auto;
	}

	.sf-query-body > * {
		flex-shrink: 0;
	}

	.sf-query-tools {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
		gap: 0.5rem;
	}

	.sf-query-field {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.sf-query-field .sf-select {
		width: 100%;
		min-width: 0;
	}

	.sf-query-editor textarea {
		width: 100%;
		min-height: 6.5rem;
	}

	.sf-dock:has(.sf-query[open]) {
		overflow-y: auto;
	}

	.sf-dock:has(.sf-query[open]) .sf-editor {
		min-height: 9rem;
	}

	.sf-query-result {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.sf-resultwrap {
		max-height: 14rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		overflow: auto;
	}

	.sf-resulttable {
		width: max-content;
		min-width: 100%;
		border-collapse: collapse;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.sf-resulttable th,
	.sf-resulttable td {
		padding: 0.25rem 0.5rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
		white-space: nowrap;
	}

	.sf-resulttable th {
		position: sticky;
		top: 0;
		background: var(--paper-sunken);
		font-weight: 600;
	}

	.sf-resulttable td.is-null {
		color: var(--ink-faint);
		font-style: italic;
	}

	.sf-editor-fallback {
		height: 100%;
		margin: 0;
		padding: 0.75rem;
		overflow: auto;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.6;
		color: var(--ink-muted);
		white-space: pre;
	}

	.sf-editor-loading {
		display: block;
		font-family: var(--font-sans);
		color: var(--ink-faint);
	}

	.sf-findings {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		max-height: 40%;
		padding: 0.6rem 0.75rem;
		overflow-y: auto;
		border-top: 1px solid var(--line);
		background: var(--surface);
	}

	.sf-findings[hidden] {
		display: none;
	}

	.sf-finding-title {
		margin: 0.25rem 0 0;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--ink-faint);
	}

	.sf-finding {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
		padding: 0.4rem 0.55rem;
		border: 0;
		border-left: 3px solid var(--line-strong);
		border-radius: 4px;
		background: var(--paper-sunken);
		color: var(--ink);
		font: inherit;
		font-size: 0.8125rem;
		line-height: 1.45;
		text-align: left;
	}

	button.sf-finding {
		cursor: pointer;
	}

	button.sf-finding:hover {
		background: color-mix(in oklab, var(--ink) 6%, var(--paper-sunken));
	}

	.sf-finding-error {
		border-left-color: var(--sev-critical);
	}

	.sf-finding-warning {
		border-left-color: var(--sev-high);
	}

	.sf-finding-info {
		border-left-color: var(--sev-low);
	}

	.sf-finding-ok {
		border-left-color: var(--check-pass);
	}

	.sf-finding-progress {
		border-left-color: var(--focus);
	}

	.sf-finding-pos {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}

	.sf-engine-message {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		white-space: pre-wrap;
	}

	.sf-finding-box {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.45rem 0.55rem;
		border-radius: 4px;
		background: color-mix(in oklab, var(--focus) 10%, var(--surface));
		font-size: 0.8125rem;
	}

	.sf-dock-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 0.75rem;
		border-top: 1px solid var(--line);
	}

	.sf-dock-buttons {
		display: flex;
		gap: 0.4rem;
	}

	.sf-dock-hint,
	.sf-dock-blocked,
	.sf-dock-warning {
		flex: 1 1 12rem;
		margin: 0;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--ink-muted);
	}

	.sf-dock-blocked {
		color: var(--sev-critical);
	}

	.sf-dock-warning {
		flex-basis: 100%;
		color: var(--sev-high);
	}

	.sf-btn-test {
		margin-left: auto;
	}

	.sf-canvas {
		position: relative;
		flex: 1;
		min-width: 0;
		min-height: 0;
		overflow: hidden;
		background-color: var(--paper);
		background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
		background-size: 22px 22px;
		cursor: default;
		touch-action: none;
		outline: none;
		-webkit-user-select: none;
		user-select: none;
	}

	.sf-canvas :is(input, textarea) {
		-webkit-user-select: text;
		user-select: text;
	}

	html.sf-dragging,
	html.sf-dragging * {
		-webkit-user-select: none !important;
		user-select: none !important;
	}

	.sf-canvas.is-space {
		cursor: grab;
	}

	.sf-canvas.is-panning {
		cursor: grabbing;
	}

	.sf-canvas.is-connecting {
		cursor: crosshair;
	}

	.sf-world {
		position: absolute;
		inset: 0 auto auto 0;
		width: 1px;
		height: 1px;
		transform-origin: 0 0;
	}

	.sf-areas,
	.sf-cards,
	.sf-notes {
		position: absolute;
		top: 0;
		left: 0;
	}

	.sf-edges {
		position: absolute;
		top: 0;
		left: 0;
		overflow: visible;
		pointer-events: none;
	}

	.sf-edge-hit {
		fill: none;
		stroke: transparent;
		stroke-width: 14;
		pointer-events: stroke;
		cursor: pointer;
	}

	.sf-edge-line,
	.sf-edge-end {
		fill: none;
		stroke: var(--ink-faint);
		stroke-width: 1.5;
		pointer-events: none;
		transition: stroke 120ms ease;
	}

	.sf-edge-end {
		fill: var(--paper);
	}

	.sf-edge.is-hot .sf-edge-line,
	.sf-edge.is-hot .sf-edge-end,
	.sf-edge:hover .sf-edge-line,
	.sf-edge:hover .sf-edge-end {
		stroke: var(--ink-muted);
		stroke-width: 2;
	}

	.sf-edge.is-selected .sf-edge-line,
	.sf-edge.is-selected .sf-edge-end {
		stroke: var(--focus);
		stroke-width: 2.25;
	}

	.sf-edge.has-error .sf-edge-line {
		stroke: var(--sev-critical);
		stroke-dasharray: 4 3;
	}

	.sf-edge-error circle {
		fill: var(--sev-critical);
	}

	.sf-edge-error path {
		stroke: var(--surface);
		stroke-width: 2;
		stroke-linecap: round;
	}

	.sf-edge-preview {
		fill: none;
		stroke: var(--focus);
		stroke-width: 1.5;
		stroke-dasharray: 6 4;
		pointer-events: none;
	}

	.sf-card {
		position: absolute;
		top: 0;
		left: 0;
		box-sizing: border-box;
		width: 260px;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-sm);
		background: var(--surface);
		box-shadow: var(--shadow-card);
		user-select: none;
		touch-action: none;
		transition: border-color 120ms ease, box-shadow 120ms ease;
	}

	.sf-card:hover {
		border-color: var(--ink-faint);
	}

	.sf-card.is-selected {
		border-color: var(--focus);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--focus) 25%, transparent), var(--shadow-card);
	}

	.sf-card:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.sf-canvas.is-moving .sf-card.is-selected {
		box-shadow: 0 12px 28px oklch(18% 0.008 260 / 0.16);
	}

	.sf-card.is-pulsing {
		animation: sf-ring 600ms ease-out 2;
	}

	@keyframes sf-ring {
		from {
			box-shadow: 0 0 0 0 color-mix(in oklab, var(--focus) 55%, transparent);
		}
		to {
			box-shadow: 0 0 0 10px transparent;
		}
	}

	.sf-card-head {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		box-sizing: border-box;
		height: 44px;
		padding: 0 0.4rem 0 0.75rem;
		border-bottom: 1px solid var(--line);
		border-radius: var(--radius-sm) var(--radius-sm) 0 0;
		background: var(--paper-sunken);
		cursor: grab;
	}

	.sf-card-name {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		font-size: 0.875rem;
		font-weight: 600;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sf-card-count {
		flex: none;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--ink-faint);
	}

	.sf-card-menu {
		display: grid;
		place-items: center;
		width: 24px;
		height: 24px;
		border: 0;
		border-radius: 4px;
		background: none;
		color: var(--ink-muted);
		cursor: pointer;
		opacity: 0;
	}

	.sf-card:hover .sf-card-menu,
	.sf-card.is-selected .sf-card-menu,
	.sf-card-menu:focus-visible {
		opacity: 1;
	}

	.sf-card-menu:hover {
		background: color-mix(in oklab, var(--ink) 8%, transparent);
	}

	.sf-dot {
		flex: none;
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}

	.sf-dot-error {
		background: var(--sev-critical);
	}

	.sf-dot-warning {
		background: var(--sev-high);
	}

	.sf-dot-info {
		background: var(--sev-low);
	}

	.sf-rows {
		margin: 0;
		padding: 5px 0;
		list-style: none;
	}

	.sf-row {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		box-sizing: border-box;
		height: 28px;
		padding: 0 0.75rem 0 0.25rem;
		font-size: 0.8125rem;
		outline: none;
	}

	.sf-row:hover {
		background: var(--sf-row-hot);
	}

	.sf-row:focus-visible {
		box-shadow: inset 0 0 0 2px var(--focus);
	}

	.sf-row.is-source {
		background: var(--sf-row-sel);
	}

	.sf-row.is-drop {
		background: var(--sf-drop);
		box-shadow: inset 2px 0 0 var(--focus);
	}

	.sf-row.is-drop-warn {
		background: var(--sf-drop-warn);
		box-shadow: inset 2px 0 0 var(--sev-high);
	}

	.sf-card-head.is-drop-head {
		outline: 1.5px dashed var(--focus);
		outline-offset: -3px;
	}

	.sf-grip {
		display: inline-flex;
		flex: none;
		width: 12px;
		color: var(--ink-faint);
		cursor: grab;
		opacity: 0;
	}

	.sf-row:hover .sf-grip {
		opacity: 1;
	}

	.sf-badge-slot {
		display: inline-flex;
		flex: none;
		width: 28px;
	}

	.sf-badge {
		min-width: 1.75rem;
		padding: 0.05rem 0.3rem;
		border: 1px solid transparent;
		border-radius: 4px;
		background: none;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 600;
		line-height: 1.5;
		text-align: center;
		cursor: help;
	}

	.sf-badge-pk {
		border-color: var(--sev-medium);
		background: color-mix(in oklab, var(--sev-medium) 22%, var(--surface));
	}

	.sf-badge-fk {
		border-color: var(--sev-low);
		background: color-mix(in oklab, var(--sev-low) 18%, var(--surface));
	}

	.sf-badge-uq {
		border-color: var(--area-ia-line);
		background: var(--area-ia-bg);
		color: var(--area-ia-fg);
	}

	.sf-col-name {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sf-col-type {
		flex: none;
		max-width: 48%;
		overflow: hidden;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--ink-faint);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sf-col-type.is-raw {
		text-decoration: underline dotted;
		text-underline-offset: 3px;
	}

	.sf-null {
		margin-left: 1px;
	}

	.sf-conn {
		position: absolute;
		top: 50%;
		z-index: 2;
		width: 10px;
		height: 10px;
		margin-top: -5px;
		border: 1.5px solid var(--line-strong);
		border-radius: 50%;
		background: var(--surface);
		cursor: crosshair;
		opacity: 0;
		transition: opacity 120ms ease;
	}

	.sf-conn::before {
		content: '';
		position: absolute;
		inset: -5px;
	}

	.sf-conn-l {
		left: -6px;
	}

	.sf-conn-r {
		right: -6px;
	}

	.sf-row:hover .sf-conn,
	.sf-canvas.is-connecting .sf-row.is-source .sf-conn {
		opacity: 1;
	}

	.sf-conn:hover {
		border-color: var(--focus);
		background: var(--focus);
	}

	@media (hover: none) {
		.sf-conn,
		.sf-grip {
			display: none;
		}
	}

	.sf-add {
		padding: 0 0.4rem;
	}

	.sf-add-btn {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		width: 100%;
		height: 24px;
		padding: 0 0.4rem;
		border: 0;
		border-radius: 4px;
		background: none;
		color: var(--ink-muted);
		font: inherit;
		font-size: 0.8125rem;
		cursor: pointer;
	}

	.sf-add-btn:hover {
		background: var(--paper-sunken);
		color: var(--ink);
	}

	.sf-reorder-line {
		position: absolute;
		left: 8px;
		right: 8px;
		height: 2px;
		background: var(--focus);
		pointer-events: none;
	}

	.sf-inline {
		flex: 1;
		min-width: 0;
		height: 24px;
		padding: 0 0.3rem;
		border: 1px solid var(--focus);
		border-radius: 4px;
		background: var(--surface);
		color: var(--ink);
		font: inherit;
		outline: none;
	}

	.sf-inline-name {
		font-weight: 600;
	}

	.sf-inline-type {
		flex: 0 0 44%;
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	.sf-inline.is-invalid {
		border-color: var(--sev-critical);
	}

	.sf-inline-msg {
		position: absolute;
		top: 46px;
		left: 0;
		right: 0;
		z-index: 4;
		padding: 0 0.75rem;
		font-size: 0.72rem;
		color: var(--sev-critical);
		pointer-events: none;
	}

	.sf-inline-msg:empty {
		display: none;
	}

	.sf-note {
		position: absolute;
		top: 0;
		left: 0;
		box-sizing: border-box;
		padding: 10px;
		border: 1px solid var(--area-movil-line);
		border-radius: var(--radius-sm);
		background: var(--area-movil-bg);
		color: var(--ink);
		font-size: 0.8125rem;
		line-height: 1.5;
		box-shadow: var(--shadow-card);
		cursor: grab;
		user-select: none;
	}

	.sf-note-text {
		height: 100%;
		overflow: hidden;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.sf-note-text:empty::before {
		content: attr(data-placeholder);
		color: var(--ink-faint);
	}

	.sf-note-input {
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--ink);
		font: inherit;
		resize: none;
		outline: none;
	}

	.sf-note-resize {
		position: absolute;
		right: 2px;
		bottom: 2px;
		width: 12px;
		height: 12px;
		border-right: 2px solid var(--ink-faint);
		border-bottom: 2px solid var(--ink-faint);
		cursor: nwse-resize;
		opacity: 0;
	}

	.sf-note:hover .sf-note-resize,
	.sf-note.is-selected .sf-note-resize {
		opacity: 0.6;
	}

	.sf-area {
		position: absolute;
		top: 0;
		left: 0;
		box-sizing: border-box;
		border: 1px solid var(--area-fullstack-line);
		border-radius: var(--radius);
		background: color-mix(in oklab, var(--area-fullstack-bg) 70%, transparent);
	}

	.sf-area-title {
		display: flex;
		align-items: center;
		height: 32px;
		padding: 0 12px;
		color: var(--area-fullstack-fg);
		font-size: 0.8125rem;
		font-weight: 600;
		cursor: grab;
		outline: none;
	}

	.sf-area-title:focus-visible {
		box-shadow: inset 0 0 0 2px var(--focus);
		border-radius: var(--radius) var(--radius) 0 0;
	}

	.sf-area-handle {
		position: absolute;
		width: 10px;
		height: 10px;
		border: 1px solid var(--focus);
		background: var(--surface);
	}

	.sf-area-handle.sf-nw {
		top: -5px;
		left: -5px;
		cursor: nwse-resize;
	}

	.sf-area-handle.sf-ne {
		top: -5px;
		right: -5px;
		cursor: nesw-resize;
	}

	.sf-area-handle.sf-sw {
		bottom: -5px;
		left: -5px;
		cursor: nesw-resize;
	}

	.sf-area-handle.sf-se {
		right: -5px;
		bottom: -5px;
		cursor: nwse-resize;
	}

	.sf-colour-fullstack {
		--sf-c-bg: var(--area-fullstack-bg);
		--sf-c-line: var(--area-fullstack-line);
		--sf-c-fg: var(--area-fullstack-fg);
	}

	.sf-colour-ia {
		--sf-c-bg: var(--area-ia-bg);
		--sf-c-line: var(--area-ia-line);
		--sf-c-fg: var(--area-ia-fg);
	}

	.sf-colour-datos {
		--sf-c-bg: var(--area-datos-bg);
		--sf-c-line: var(--area-datos-line);
		--sf-c-fg: var(--area-datos-fg);
	}

	.sf-colour-movil {
		--sf-c-bg: var(--area-movil-bg);
		--sf-c-line: var(--area-movil-line);
		--sf-c-fg: var(--area-movil-fg);
	}

	.sf-colour-seguridad {
		--sf-c-bg: var(--area-seguridad-bg);
		--sf-c-line: var(--area-seguridad-line);
		--sf-c-fg: var(--area-seguridad-fg);
	}

	.sf-colour-infra {
		--sf-c-bg: var(--area-infra-bg);
		--sf-c-line: var(--area-infra-line);
		--sf-c-fg: var(--area-infra-fg);
	}

	.sf-colour-neutral {
		--sf-c-bg: var(--paper-sunken);
		--sf-c-line: var(--line-strong);
		--sf-c-fg: var(--ink-muted);
