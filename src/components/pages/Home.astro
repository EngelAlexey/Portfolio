---
import OrgLink from '../OrgLink.astro';
import OrgLogoLink from '../OrgLogoLink.astro';
import Layout from '../../layouts/Layout.astro';
import BrandMark from '../BrandMark.astro';
import Container from '../Container.astro';
import ProjectCard from '../ProjectCard.astro';
import ToolGrid from '../ToolGrid.astro';
import { EXPERIENCE, text } from '../../lib/about';
import { AREA_IDS, areaLabel, areaStyle } from '../../lib/areas';
import { heroTools } from '../../lib/brands';
import { areaCounts, homeProjects } from '../../lib/content';
import { path, t, type Lang } from '../../lib/i18n';
import { CV, CV_DEFAULT } from '../../lib/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const strings = t(lang);
const featured = await homeProjects(lang);
const tools = heroTools();
const orgs = EXPERIENCE.filter((role) => role.mark);
const cvHref = CV[CV_DEFAULT][lang];
const counts = await areaCounts(lang);
const projectsHref = path(lang, 'projects');
---

<Layout
	{lang}
	key="home"
	title={strings.meta.defaultTitle}
	description={strings.meta.defaultDescription}
>
	<Container as="header" size="wide">
		<div class="hero">
			<div class="lede">
				<p class="badge">
					<span class="pulse" aria-hidden="true"></span>
					{strings.home.badge}
				</p>

				<h1>{strings.home.headline}</h1>
				<p class="pitch">{strings.home.pitch}</p>

				<div class="actions">
					<a class="btn primary" href={projectsHref}>{strings.home.ctaProjects}</a>
					<a class="btn" href={cvHref} download>{strings.home.ctaCv}</a>
				</div>
			</div>

			<nav class="index" aria-label={strings.home.areasLabel}>
				<p class="indexhead">{strings.home.areasLabel}</p>
				<ul>
					{
						AREA_IDS.map((area) => (
							<li>
								<a
									href={`${projectsHref}#${area}`}
									style={areaStyle(area)}
									data-area={area}
									data-area-source
								>
									<span class="dot" aria-hidden="true" />
									<span class="name">{areaLabel(area, lang)}</span>
									<span class="n">{counts[area]}</span>
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<ul class="herostack" aria-label={strings.home.heroStackLabel}>
				{tools.map((tool, i) => (
					<li title={tool.label} style={`--i: ${i}`}>
						<BrandMark {tool} />
						<span class="sr-only">{tool.label}</span>
					</li>
				))}
			</ul>
		</div>
	</Container>

	<div class="band">
		<Container>
			<div class="section">
				<h2>{strings.home.orgsLabel}</h2>
				<p class="seclede">{strings.home.orgsLede}</p>
				<ul class="orgs">
					{
						orgs.map((role) => (
							<li>
								<OrgLogoLink org={role.mark!} />
								<span class="orgtext">
									<strong>
										<OrgLink name={role.shortOrg ?? text(role.org, lang)} {lang} />
									</strong>
									<span class="meta">
										{role.title[lang]} · {role.period[lang]}
									</span>
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</Container>
	</div>

	{
		featured.length > 0 && (
			<Container>
				<div class="section">
					<h2>{strings.home.workTitle}</h2>
					<p class="seclede">{strings.home.workLede}</p>

					<ul class="grid">
						{featured.map((project) => (
							<li data-areas={project.meta.areas.join(' ')}>
								<ProjectCard {project} {lang} />
							</li>
						))}
					</ul>

					<p class="more">
						<a href={projectsHref}>{strings.home.workAll}</a>
					</p>
				</div>
			</Container>
		)
	}

	<div class="band">
		<Container>
			<div class="section last">
				<h2>{strings.home.stackLabel}</h2>
				<p class="seclede">{strings.stack.lead}</p>
				<ToolGrid {lang} />
			</div>
		</Container>
	</div>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 5vw, 3.25rem);
	}

	.lede {
		max-width: 40rem;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1.75rem;
		padding: 0.3rem 0.75rem 0.3rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: transparent;
		color: var(--ink-muted);
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.pulse {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--available);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--available) 22%, transparent);
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 4.6vw, 3.25rem);
		line-height: 1.06;
		letter-spacing: -0.035em;
		font-weight: 600;
		text-wrap: pretty;
	}

	.pitch {
		margin: 1.5rem 0 0;
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--ink-muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.index {
		align-self: start;
	}

	.indexhead {
		margin: 0 0 0.75rem;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--ink-faint);
	}

	.index ul {
		display: grid;
		gap: 1px;
		list-style: none;
		margin: 0;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--line);
		overflow: hidden;
	}

	.index a {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.6rem 0.9rem;
		background: var(--surface);
		text-decoration: none;
		font-size: 0.9375rem;
		color: var(--ink-muted);
		transition:
			background-color 120ms ease,
			color 120ms ease;
	}

	.index a:hover,
	.index a:focus-visible {
		background: var(--chip-bg);
		color: var(--chip-fg);
	}

	.index .dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--chip-fg);
		flex: none;
	}

	.index .name {
		flex: 1;
	}

	.index .n {
		font-size: 0.8125rem;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.index a:hover .n,
	.index a:focus-visible .n {
		color: inherit;
	}

	.herostack {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
		color: var(--ink-faint);
	}

	.herostack li {
		display: flex;
		transition: color 140ms ease;
	}

	.herostack li:hover {
		color: var(--ink);
	}

	@media (min-width: 64rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(15rem, 19rem);
			column-gap: clamp(2.5rem, 6vw, 5rem);
			row-gap: 3rem;
			align-items: start;
		}

		.index {
			padding-top: 3.15rem;
		}

		.herostack {
			grid-column: 1 / -1;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(:root:not([data-vt])) .herostack li {
			opacity: 0;
			transform: translateX(-5px);
			animation: mark-in 420ms cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
			animation-delay: calc(var(--i, 0) * 42ms + 120ms);
		}
	}

	@keyframes mark-in {
		to {
			opacity: 1;
			transform: none;
		}
	}

	.band {
		background: var(--paper-sunken);
		border-block: 1px solid var(--line);
	}

	.band + .band {
		border-top: 0;
	}

	.section {
		padding-block: clamp(2.5rem, 6vw, 4rem);
	}

	.section.last {
		padding-bottom: clamp(3rem, 7vw, 5rem);
	}

	h2 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.seclede {
		margin: 0.45rem 0 1.75rem;
		max-width: 52ch;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}

	.orgs {
		display: grid;
		gap: 1px;
		list-style: none;
		margin: 0;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--line);
		overflow: hidden;
	}

	.orgs li {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		padding: 1.1rem 1.35rem;
		background: var(--surface);
	}

	.orgs li :global(.mark) {
		width: 9.375rem;
		flex: none;
	}

	.orgs li:hover :global(.mark) {
		color: var(--ink);
	}

	.orgtext {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
	}

	.orgtext strong {
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.orgtext .meta {
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	@media (min-width: 46rem) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.more {
		margin: 1.25rem 0 0;
		font-size: 0.9375rem;
	}

	.more a {
		color: var(--ink-muted);
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
		padding-bottom: 0.15rem;
	}

	.more a:hover {
		color: var(--ink);
		border-bottom-color: var(--ink);
	}

	@media (max-width: 40rem) {
		.orgs li {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}

		.orgs li :global(.mark) {
			width: 8rem;
		}
	}
</style>
