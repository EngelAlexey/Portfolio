---
import Layout from '../../layouts/Layout.astro';
import Container from '../Container.astro';
import { t, type Lang } from '../../lib/i18n';
import { PRIVACY_UPDATED } from '../../lib/i18n/privacy-es';
import { PERSON } from '../../lib/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);
const text = strings.privacy;

const updated = new Intl.DateTimeFormat(lang === 'es' ? 'es' : 'en-GB', {
	dateStyle: 'long',
	timeZone: 'UTC'
}).format(new Date(`${PRIVACY_UPDATED}T00:00:00Z`));
---

<Layout {lang} key="privacy" title={strings.meta.titleTemplate(text.title)} description={text.lead}>
	<Container as="header" size="text">
		<div class="head">
			<h1>{text.title}</h1>
			<p>{text.lead}</p>
			<p class="updated"><time datetime={PRIVACY_UPDATED}>{text.updated(updated)}</time></p>
		</div>
	</Container>

	<Container size="text">
		<div class="doc">
			{
				text.sections.map((section) => (
					<section id={section.id} aria-labelledby={`${section.id}-title`}>
						<h2 id={`${section.id}-title`}>{section.title}</h2>
						{section.blocks.map((block) => {
							switch (block.kind) {
								case 'p':
									return <p>{block.text}</p>;
								case 'h3':
									return <h3>{block.text}</h3>;
								case 'list':
									return (
										<ul>
											{block.items.map((item) => (
												<li>{item}</li>
											))}
										</ul>
									);
								case 'table':
									return (
										<div class="table-wrap" role="region" aria-label={block.caption} tabindex="0">
											<table class:list={{ mono: block.mono === true }}>
												<caption class="sr-only">{block.caption}</caption>
												<thead>
													<tr>
														{block.head.map((cell) => (
															<th scope="col">{cell}</th>
														))}
													</tr>
												</thead>
												<tbody>
													{block.rows.map((row) => (
														<tr>
															{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
														</tr>
													))}
												</tbody>
											</table>
										</div>
									);
								case 'links':
									return (
										<ul class="links">
											{block.items.map((item) => (
												<li>
													<a href={item.href} rel="noreferrer" target="_blank">
														{item.label}
														<span class="ext" aria-hidden="true">↗</span>
														<span class="sr-only">{strings.a11y.newTab}</span>
													</a>
												</li>
											))}
										</ul>
									);
								case 'contact':
									return (
										<p>
											{text.contactLabel}: <a href={`mailto:${PERSON.email}`}>{PERSON.email}</a>
										</p>
									);
								case 'choice':
									return (
										<div class="choice">
											<p>
												{text.choice.current}:{' '}
												<span
													data-cookie-state
													data-granted={text.choice.granted}
													data-denied={text.choice.denied}
													data-none={text.choice.none}
												>
													{text.choice.none}
												</span>
											</p>
											<button type="button" class="btn" data-cookie-settings>
												{text.choice.change}
											</button>
										</div>
									);
							}
						})}
					</section>
				))
			}
		</div>
	</Container>
</Layout>

<style>
	.head {
		padding-block: clamp(2.5rem, 7vw, 4rem) 1.5rem;
	}

	h1 {
		margin: 0;
		font-size: var(--h1);
		font-weight: 600;
		letter-spacing: -0.03em;
	}

	.head p {
		margin: 0.6rem 0 0;
		color: var(--ink-muted);
		font-size: 1.0625rem;
		line-height: 1.6;
	}

	.head .updated {
		font-size: 0.9375rem;
		color: var(--ink-faint);
	}

	.doc {
		padding-bottom: 4rem;
		font-size: 1.0625rem;
		line-height: 1.7;
	}

	section {
		scroll-margin-top: 5rem;
	}

	h2 {
		margin: 2.75rem 0 0.85rem;
		font-size: 1.3125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	section:first-child h2 {
		margin-top: 1.5rem;
	}

	h3 {
		margin: 1.75rem 0 0.4rem;
		font-size: 1.0625rem;
		font-weight: 600;
	}

	.doc p {
		margin: 0 0 0.9rem;
		max-width: var(--measure);
	}

	.doc ul {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
		max-width: var(--measure);
	}

	.doc ul.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.5rem;
		padding: 0;
		list-style: none;
	}

	.doc a {
		color: var(--ink);
		text-underline-offset: 0.2em;
	}

	.table-wrap {
		overflow-x: auto;
		margin: 0 0 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
	}

	table {
		width: 100%;
		min-width: 34rem;
		border-collapse: collapse;
		font-size: 0.9375rem;
		line-height: 1.5;
	}

	th,
	td {
		padding: 0.65rem 0.8rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}

	thead th {
		background: var(--paper-sunken);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	tbody th {
		font-weight: 500;
	}

	tbody tr:last-child th,
	tbody tr:last-child td {
		border-bottom: 0;
	}

	table.mono tbody th {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		word-break: break-word;
	}

	.choice {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin-bottom: 1rem;
	}

	.choice p {
		margin: 0;
	}

	.ext {
		margin-left: 0.15em;
	}
</style>
