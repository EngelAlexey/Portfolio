---
import Layout from '../../layouts/Layout.astro';
import Avatar from '../Avatar.astro';
import Container from '../Container.astro';
import OrgLogoLink from '../OrgLogoLink.astro';
import {
	CERTIFICATIONS,
	EDUCATION,
	EXPERIENCE,
	LANGUAGES,
	SKILL_GROUPS,
	text,
	type Role
} from '../../lib/about';
import { splitOrg } from '../../lib/org';
import { t, type Lang } from '../../lib/i18n';
import { PERSON } from '../../lib/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const strings = t(lang);

const months = (value: string) => {
	const [year, month] = value.split('-').map(Number);
	return year * 12 + month;
};

const orgName = (role: Role) => splitOrg(text(role.org, lang)).name;

type Lane = {
	key: string;
	name: string;
	mark: Role['mark'];
	engagement: string | null;
	roles: Role[];
	start: number;
};

function lanes(list: Role[]): Lane[] {
	const byOrg = new Map<string, Lane>();
	for (const role of list) {
		const key = splitOrg(typeof role.org === 'string' ? role.org : role.org.es).name;
		const lane = byOrg.get(key);
		if (lane) {
			lane.roles.push(role);
			lane.start = Math.min(lane.start, months(role.range.start));
			if (role.mark) lane.mark = role.mark;
			if (role.engagement) lane.engagement = role.engagement[lang];
		} else {
			byOrg.set(key, {
				key,
				name: orgName(role),
				mark: role.mark,
				engagement: role.engagement ? role.engagement[lang] : null,
				roles: [role],
				start: months(role.range.start)
			});
		}
	}
	return [...byOrg.values()];
}

const work = lanes(EXPERIENCE);
const study = lanes(EDUCATION);
work.sort((a, b) => b.start - a.start);

const all = [...work, ...study];

const skills = SKILL_GROUPS.map((group) => ({
	label: group.label[lang],
	items: group.items.map((item) => text(item, lang))
}));
---

<Layout
	{lang}
	key="about"
	title={strings.meta.titleTemplate(strings.about.title)}
	description={strings.about.lead}
>
	<Container as="header" size="wide">
		<div class="masthead">
			<Avatar alt={strings.about.photoAlt} size={92} />
			<div class="who">
				<h1>{PERSON.name}</h1>
				<p class="role">{strings.home.role}</p>
			</div>
			<p class="intro">{strings.about.intro}</p>
		</div>
	</Container>

	<Container size="wide">
		<section class="track" aria-label={strings.about.experience}>
			<div class="chart">
				<ol class="lanes">
					{
						all.map((lane, index) => (
							<li
								class:list={['lane', { study: index >= work.length }]}
							>
								<div class="label">
									{lane.mark ? (
										<>
											<OrgLogoLink org={lane.mark} width={118} />
											<h3 class="sr-only">{lane.name}</h3>
										</>
									) : (
										<h3>{lane.name}</h3>
									)}

									{lane.engagement && <p class="engagement">{lane.engagement}</p>}
								</div>

								<div class="posts">
									{lane.roles.map((role) => (
										<article class="post">
											<h4>{role.title[lang]}</h4>
											<p class="when">{role.period[lang]}</p>
											<ul class="points">
												{role.detail[lang].map((point) => (
													<li>{point}</li>
												))}
											</ul>
										</article>
									))}
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>
	</Container>

	<Container size="wide">
		<section class="skills" aria-labelledby="skills-heading">
			<h2 id="skills-heading">{strings.about.skills}</h2>
			<dl>
				{
					skills.map((group) => (
						<div class="group">
							<dt>{group.label}</dt>
							<dd>{group.items.join(', ')}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</Container>

	<Container size="wide">
		<section class="footnotes">
			<div>
				<h2>{strings.about.certifications}</h2>
				<ul>
					{
						CERTIFICATIONS.map((cert) => (
							<li>
								<span class="name">{cert.name}</span>
								<span class="by">
									{cert.issuer}
									{cert.status && <em>{cert.status[lang]}</em>}
								</span>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2>{strings.about.languages}</h2>
				<ul>
					{
						LANGUAGES.map((language) => (
							<li>
								<span class="name">{language.label[lang]}</span>
								<span class="by">{language.level[lang]}</span>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</Container>
</Layout>

<style>
	.masthead {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.4rem 1.35rem;
		padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
	}

	h1 {
		margin: 0;
		font-size: clamp(1.9rem, 4.4vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.02;
		text-wrap: balance;
	}

	.role {
		margin: 0.4rem 0 0;
		font-size: 0.9375rem;
		color: var(--ink-faint);
	}

	.intro {
		grid-column: 1 / -1;
		margin: 1.4rem 0 0;
		max-width: 46ch;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	@media (min-width: 60rem) {
		.masthead {
			grid-template-columns: auto minmax(0, 22rem) minmax(0, 1fr);
			column-gap: clamp(2rem, 5vw, 4rem);
			align-items: end;
		}

		.intro {
			grid-column: 3;
			margin: 0;
			padding-bottom: 0.2rem;
		}
	}

	.track {
		padding-top: 0.5rem;
	}

	h2 {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.chart {
		border-top: 1px solid var(--line-strong);
	}

	.lanes {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.lane {
		display: grid;
		gap: 0.5rem 1.5rem;
		padding-block: 1.1rem;
		border-top: 1px solid var(--line);
	}

	.lane.study {
		border-top: 1px solid var(--line-strong);
	}

	.label :global(.mark) {
		color: var(--ink-muted);
	}

	.lane:hover .label :global(.mark) {
		color: var(--ink);
	}

	.label h3 {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.engagement {
		margin: 0.5rem 0 0;
		font-size: 0.8125rem;
		color: var(--ink-faint);
	}

	.posts {
		display: grid;
		gap: 1.35rem;
		max-width: 68ch;
	}

	.post h4 {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.when {
		margin: 0.1rem 0 0;
		font-size: 0.8125rem;
		color: var(--ink-faint);
		font-variant-numeric: tabular-nums;
	}

	.points {
		margin: 0.6rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.4rem;
	}

	.points li {
		position: relative;
		padding-left: 1rem;
		font-size: 0.9375rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	.points li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.6em;
		width: 0.3rem;
		height: 1px;
		background: var(--line-strong);
	}

	@media (min-width: 60rem) {
		.lane {
			grid-template-columns: 17rem minmax(0, 1fr);
			align-items: start;
		}

	}

	.skills {
		padding-block: clamp(2.5rem, 6vw, 4rem) 0;
	}

	.skills dl {
		margin: 1.25rem 0 0;
		border-top: 1px solid var(--line);
	}

	.group {
		display: grid;
		gap: 0.15rem 1.5rem;
		padding-block: 0.8rem;
		border-bottom: 1px solid var(--line);
	}

	.group dt {
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.group dd {
		margin: 0;
		font-size: 0.9375rem;
		line-height: 1.6;
		color: var(--ink-muted);
	}

	@media (min-width: 46rem) {
		.group {
			grid-template-columns: 13rem minmax(0, 1fr);
			align-items: baseline;
		}
	}

	.footnotes {
		display: grid;
		gap: 2rem;
		padding-block: clamp(2.5rem, 6vw, 3.5rem) clamp(3rem, 7vw, 5rem);
	}

	@media (min-width: 46rem) {
		.footnotes {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 3rem;
		}
	}

	.footnotes h2 {
		font-size: 1rem;
	}

	.footnotes ul {
		list-style: none;
		margin: 0.9rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}

	.footnotes li {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.name {
		font-size: 0.9375rem;
		font-weight: 500;
	}

	.by {
		font-size: 0.875rem;
		color: var(--ink-muted);
	}

	.by em {
		margin-left: 0.5rem;
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		font-size: 0.75rem;
		font-style: normal;
		color: var(--ink-faint);
	}
</style>
