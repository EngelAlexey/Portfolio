---
import { areaLabel, areaStyle, type AreaId } from '../lib/areas';
import type { Lang } from '../lib/i18n';

interface Props {
	area: AreaId;
	lang: Lang;
	size?: 'sm' | 'md';
}

const { area, lang, size = 'md' } = Astro.props;
---

<span class:list={['chip', { sm: size === 'sm' }]} style={areaStyle(area)} data-area={area}>
	<span class="dot" aria-hidden="true"></span>
	{areaLabel(area, lang)}
</span>

<style>
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.25em 0.6em;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: transparent;
		color: var(--ink-muted);
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.35;
		white-space: nowrap;
	}

	.chip.sm {
		font-size: 0.75rem;
		padding: 0.15em 0.5em;
	}

	.dot {
		width: 0.45em;
		height: 0.45em;
		border-radius: 999px;
		background: var(--chip-fg);
		flex: none;
	}
</style>
