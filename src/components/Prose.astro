---

<div class="prose">
	<slot />
</div>

<style>
	.prose {
		max-width: var(--measure);
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--ink);
	}

	.prose :global(h2) {
		position: relative;
		margin: 2.75rem 0 0.85rem;
		padding-left: 0.9rem;
		font-size: 1.3125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
		scroll-margin-top: 5rem;
	}

	.prose :global(h2)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.28em;
		bottom: 0.24em;
		width: 3px;
		border-radius: 3px;
		background: var(--accent);
	}

	.prose :global(h2:first-child) {
		margin-top: 2.25rem;
	}

	.prose :global(h3) {
		margin: 1.75rem 0 0.5rem;
		font-size: 1.0625rem;
		font-weight: 600;
	}

	.prose :global(p) {
		margin: 0 0 1rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		margin: 0 0 1rem;
		padding-left: 1.25rem;
	}

	.prose :global(ul) {
		list-style: disc;
	}

	.prose :global(ol) {
		list-style: decimal;
	}

	.prose :global(li) {
		margin-bottom: 0.35rem;
	}

	.prose :global(li::marker) {
		color: var(--ink-faint);
	}

	.prose :global(a) {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-color: var(--line-strong);
	}

	.prose :global(a:hover) {
		text-decoration-color: currentColor;
	}

	.prose :global(strong) {
		font-weight: 600;
	}

	.prose :global(code) {
		font-size: 0.875em;
		padding: 0.1em 0.35em;
		border: 1px solid var(--line);
		border-radius: var(--radius-sm);
		background: var(--paper-sunken);
	}

	.prose :global(pre) {
		margin: 1.25rem 0;
		padding: 1rem;
		overflow-x: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--paper-sunken);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.prose :global(pre code) {
		padding: 0;
		border: 0;
		background: none;
	}

	.prose :global(blockquote) {
		margin: 1.5rem 0;
		padding-left: 1rem;
		border-left: 2px solid var(--line-strong);
		color: var(--ink-muted);
	}

	.prose :global(hr) {
		margin: 2.5rem 0;
		border: 0;
		border-top: 1px solid var(--line);
	}

	.prose :global(table) {
		width: 100%;
		margin: 1.5rem 0;
		border-collapse: collapse;
		font-size: 0.9375rem;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}

	.prose :global(th) {
		font-weight: 600;
		color: var(--ink-muted);
		font-size: 0.8125rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}
</style>
