---
import AreaChip from './AreaChip.astro';
import type { Project } from '../lib/content';
import { formatPeriod } from '../lib/format';
import { path, t, type Lang } from '../lib/i18n';

interface Props {
	project: Project;
	lang: Lang;
	/**
	 * Set where the card already sits under a heading that names its
	 * organisation, so the eyebrow does not say it a second time.
	 */
	omitOrg?: boolean;
}

const { project, lang, omitOrg = false } = Astro.props;

const meta = project.meta;
const strings = t(lang);
const href = path(lang, 'project', meta.slug);
const years = formatPeriod(meta.period, strings.project.present, 'year');
---

<article class="card">
	<div class="eyebrow">
		<span>{strings.kind[meta.kind]}</span>
		{
			meta.org && !omitOrg && (
				<>
					<span class="sep" aria-hidden="true">
						·
					</span>
					<span>{meta.org}</span>
				</>
			)
		}
		<span class="sep" aria-hidden="true">·</span>
		<span class="years">{years}</span>
	</div>

	<h3 class="title">
		{
			href ? (
				<a href={href}>{meta.title}</a>
			) : (
				meta.title
			)
		}
	</h3>

	<p class="tagline">{meta.tagline}</p>

	<ul class="areas">
		{meta.areas.map((area) => <li><AreaChip {area} {lang} size="sm" /></li>)}
	</ul>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.25rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		transition:
			border-color 140ms ease,
			transform 140ms ease,
			box-shadow 140ms ease;
	}

	.card:has(a:hover),
	.card:has(a:focus-visible) {
		border-color: var(--line-strong);
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
	}

	.eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.sep {
		color: var(--line-strong);
	}

	.title {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		margin: 0;
	}

	/* Stretched link: the whole card is the hit target, the anchor stays the
	   only thing in the tab order. */
	.title a {
		text-decoration: none;
	}

	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.tagline {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
		max-width: 46ch;
	}

	.areas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0;
	}
</style>
