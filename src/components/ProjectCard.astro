---
import AreaChip from './AreaChip.astro';
import { accentStyle } from '../lib/areas';
import type { Project } from '../lib/content';
import { formatPeriod } from '../lib/format';
import { path, t, type Lang } from '../lib/i18n';

interface Props {
	project: Project;
	lang: Lang;
	omitOrg?: boolean;
}

const { project, lang, omitOrg = false } = Astro.props;

const meta = project.meta;
const strings = t(lang);
const href = path(lang, 'project', meta.slug);
const years = formatPeriod(meta.period, strings.project.present, 'year');
const where = meta.org && !omitOrg ? `${strings.kind[meta.kind]} · ${meta.org}` : strings.kind[meta.kind];
---

<article class="card" style={accentStyle(meta.areas[0])}>
	<div class="eyebrow">
		<span class="where">{where}</span>
		<span class="years">{years}</span>
	</div>

	<h3 class="title">
		{
			href ? (
				<a href={href}>{meta.title}</a>
			) : (
				meta.title
			)
		}
	</h3>

	<p class="tagline">{meta.tagline}</p>

	<ul class="areas">
		{meta.areas.map((area) => <li><AreaChip {area} {lang} size="sm" /></li>)}
	</ul>
</article>

<style>
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 1.25rem 1.25rem 1.35rem;
		border: 1px solid var(--line);
		border-left: 2px solid var(--accent-line);
		border-radius: var(--radius);
		background: var(--surface);
		transition:
			border-color 140ms ease,
			transform 140ms ease,
			box-shadow 140ms ease;
	}

	.card:has(a:hover),
	.card:has(a:focus-visible) {
		border-color: var(--line-strong);
		border-left-color: var(--accent);
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
	}

	.eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.2rem 1rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--ink-faint);
	}

	.years {
		flex: none;
	}

	.title {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		margin: 0.15rem 0 0;
	}

	.title a {
		text-decoration: none;
	}

	.title a::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
	}

	.tagline {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
		max-width: 46ch;
	}

	.areas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		margin: auto 0 0;
		padding: 0.35rem 0 0;
	}
</style>
