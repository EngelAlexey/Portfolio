{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/en",
      "permanent": false,
      "has": [{ "type": "header", "key": "accept-language", "value": { "pre": "en" } }]
    },
    { "source": "/", "destination": "/es", "permanent": false },
    {
      "source": "/ig",
      "destination": "/es/blog?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    { "source": "/es/herramientas/revisor", "destination": "/es/herramientas/escaner", "permanent": true },
    { "source": "/es/herramientas/revisor/:path+", "destination": "/es/herramientas/escaner/:path+", "permanent": true }
  ],
  "rewrites": [
    { "source": "/es/herramientas/escaner/reporte/:id", "destination": "/es/herramientas/escaner/reporte" },
    { "source": "/en/tools/scanner/report/:id", "destination": "/en/tools/scanner/report" }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/cv/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/es/herramientas/escaner/reporte/:path*",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/en/tools/scanner/report/:path*",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/scanner/explanations/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
